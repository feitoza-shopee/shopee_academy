// ============================================================
const POSITIONS_ORDER = ['Log I','Log II','Assit','Líder','Analyst','Superv.','Coord.'];

async function renderRankingByPosition() {
  const u = state.currentUser;
  const { data: usersData } = await getDB().from('users').select('*');
  (usersData||[]).forEach(row => { state.users[row.id] = rowToUser(row); });
  const allUsers = Object.values(state.users).filter(usr => !usr.isAdmin);
  const container = document.getElementById('ranking-by-position');
  if(!container) return;

  let html = '';
  POSITIONS_ORDER.forEach(pos => {
    const group = allUsers.filter(usr => usr.position === pos);
    if(group.length === 0) return;
    group.sort((a,b) => (b.xp||0)-(a.xp||0));
    html += '<div style="background:#fff;border-radius:16px;padding:16px;margin-bottom:16px;border:2px solid var(--border);box-shadow:var(--shadow);">' +
      '<div style="font-weight:900;font-size:15px;margin-bottom:12px;color:var(--shopee);">🏅 ' + pos +
      ' <span style="font-size:11px;color:var(--text2);font-weight:700;">(' + group.length + ' colaborador' + (group.length>1?'es':'') + ')</span></div>' +
      '<div class="ranking-list" style="gap:8px;">';
    group.forEach((usr, i) => {
      const p2 = i+1;
      const cls = p2===1?'gold':p2===2?'silver':p2===3?'bronze':'other';
      const em  = p2===1?'🥇':p2===2?'🥈':p2===3?'🥉':p2;
      const me  = usr.id === u.id;
      html += '<div class="ranking-item' + (me?' me':'') + '">' +
        '<div class="rank-pos ' + cls + '">' + em + '</div>' +
        '<div class="rank-avatar">' + usr.name.charAt(0) + '</div>' +
        '<div class="rank-info"><h4>' + usr.name + (me?' (você)':'') + '</h4>' +
        '<p>' + usr.unit + ' · ' + usr.shift + ' · 🔥' + (usr.streak||0) + '</p></div>' +
        '<div class="rank-xp">⭐ ' + (usr.xp||0).toLocaleString() + '</div></div>';
    });
    html += '</div></div>';
  });
  if(!html) html = '<p style="text-align:center;color:var(--text2);font-weight:700;padding:30px 0">Nenhum colaborador com cargo cadastrado ainda.</p>';
  container.innerHTML = html;
}

