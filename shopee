function showProfileUpdateModal(user) {
  const modal = document.getElementById('modal-profile-update');
  modal.classList.remove('hidden');
  modal.style.display = 'flex';
}

async function submitProfileUpdate() {
  const position = document.getElementById('update-position').value;
  const errEl    = document.getElementById('update-profile-error');
  if(!position) {
    errEl.textContent = '⚠️ Selecione seu cargo para continuar.';
    errEl.classList.remove('hidden'); return;
  }
  errEl.classList.add('hidden');
  const user = state.currentUser;
  user.position = position;
  await saveUser(user);
  document.getElementById('modal-profile-update').classList.add('hidden');
  document.getElementById('modal-profile-update').style.display = 'none';
  // HSE é o primeiro módulo da trilha normal para TODOS os cargos (inclusive Líder).
  // O fluxo especial de tela de Líder foi descontinuado em favor da progressão sequencial unificada.
  if(user.isAdmin) {
    document.getElementById('nav-admin').classList.remove('hidden');
    document.getElementById('nav-crm').classList.remove('hidden');
    document.getElementById('nav-users').classList.remove('hidden');
    document.getElementById('nav-monitoring').classList.remove('hidden');
    document.getElementById('nav-report').classList.remove('hidden');
  }
  showScreen('screen-welcome'); updateNavStats();
  setTimeout(function() { showScreen('screen-main'); renderHome(); switchPage('home'); }, 5000);
}

