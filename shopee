    rows;
}

// Exporta as questões erradas do colaborador em CSV (abre diretamente no Excel)
function exportReportToExcel() {
  if(!_reportSearchResults || _reportSearchResults.length === 0) return;
  const u = _reportCurrentUser;

  const escapeCsv = (val) => {
    const s = String(val === undefined || val === null ? '' : val).replace(/"/g, '""');
    return '"' + s + '"';
  };

  const headerCols = ['CPF', 'Nome', 'Data', 'Módulo', 'Lição', 'Questão', 'Resposta do Colaborador', 'Resposta Correta'];
  const lines = [headerCols.map(escapeCsv).join(';')];
  _reportSearchResults.forEach(w => {
    lines.push([
      u ? u.id : '',
      u ? u.name : '',
      w.date || '',
      w.modTitle || '',
      w.lessonTitle || '',
      w.question || '',
      w.userAnswer || '',
      w.correctAnswer || ''
    ].map(escapeCsv).join(';'));
  });

  // BOM UTF-8 garante que acentos apareçam corretamente ao abrir no Excel
  const csvContent = '\uFEFF' + lines.join('\r\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const fileName = 'relatorio_' + (u ? u.id.replace(/[.\-\/]/g, '') : 'colaborador') + '_' + today() + '.csv';
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(link.href);
}

