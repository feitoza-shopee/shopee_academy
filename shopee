}
.admin-card h3 {
  font-size:16px; font-weight:900;
  margin-bottom:14px;
  display:flex; align-items:center; gap:8px;
}

.upload-zone {
  border:2.5px dashed var(--border);
  border-radius:14px;
  padding:32px 20px;
  text-align:center;
  cursor:pointer;
  transition:all 0.2s;
  background:var(--bg);
}
.upload-zone:hover { border-color:var(--shopee); background:#FFF8F6; }
.upload-zone .upload-icon { font-size:40px; margin-bottom:8px; }
.upload-zone p { font-size:14px; font-weight:700; color:var(--text2); }
.upload-zone small { font-size:12px; color:#bbb; }

.generating-indicator {
  display:flex; align-items:center; gap:10px;
  background:#FFF8F6;
  border:2px solid var(--shopee);
  border-radius:12px;
  padding:14px 16px;
  margin-top:12px;
}
.spinner {
  width:20px; height:20px;
  border:3px solid var(--border);
  border-top-color:var(--shopee);
  border-radius:50%;
  animation:spin 0.8s linear infinite;
}
@keyframes spin { to { transform:rotate(360deg); } }

.generated-questions {
  display:flex; flex-direction:column; gap:8px;
  margin-top:12px;
  max-height:300px;
  overflow-y:auto;
}
.gen-q-item {
  background:var(--bg);
  border-radius:10px;
  padding:12px 14px;
  font-size:13px; font-weight:700;
  border-left:4px solid var(--shopee);
}
.gen-q-item .q-type-tag {
  font-size:10px; text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--shopee);
  font-weight:900;
  margin-bottom:4px;
}

.users-table {
  width:100%;
  border-collapse:collapse;
  font-size:13px;
}
.users-table th {
  background:var(--bg);
  padding:10px 12px;
  text-align:left;
  font-weight:900;
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:0.5px;
  color:var(--text2);
}
.users-table td {
  padding:10px 12px;
  border-top:1px solid var(--border);
  font-weight:700;
}

.btn-danger {
  background:#E74C3C;
  color:#fff;
  border:none;
  border-radius:8px;
  padding:6px 12px;
  font-family:'Nunito',sans-serif;
  font-size:12px; font-weight:800;
  cursor:pointer;
}

/* ===== LOADING ===== */
.loading-overlay {
  position:fixed; inset:0;
  background:rgba(255,255,255,0.9);
  display:flex; align-items:center; justify-content:center;
  z-index:999;
  flex-direction:column; gap:16px;
}
.loading-overlay .spinner { width:40px; height:40px; border-width:4px; }
.loading-overlay p { font-weight:800; color:var(--text2); }

/* ===== CONFETTI ===== */
.confetti-piece {
  position:fixed;
  width:10px; height:10px;
  top:-10px;
  border-radius:2px;
  animation:confettiFall linear forwards;
  z-index:9999;
  pointer-events:none;
}
@keyframes confettiFall {
  to { transform:translateY(110vh) rotate(720deg); opacity:0; }
}
@keyframes toastIn {
  from { transform:translateX(-50%) translateY(10px); opacity:0; }
  to { transform:translateX(-50%) translateY(0); opacity:1; }
}


/* ===== WELCOME SCREEN ===== */
#screen-welcome {
  background: linear-gradient(145deg, #EE4D2D 0%, #FF7355 50%, #FFB347 100%);
