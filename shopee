function deletePDF(index) {
  const lib = getPDFLibrary();
  const pdf = lib[index];
  if(!pdf) return;
  if(!confirm(`Excluir o PDF "${pdf.name}"?\n\nO módulo/lição gerado por ele NÃO será removido automaticamente.`)) return;
  lib.splice(index, 1);
  savePDFLibrary(lib);
  const el = document.getElementById('pdf-library-list');
  if(el) el.innerHTML = renderPDFLibrary();
}

async function registerPDFInLibrary(file, moduleName) {
  const lib = getPDFLibrary();
  const now = new Date();
  const dateStr = now.toLocaleDateString('pt-BR') + ' ' + now.toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'});
  lib.push({
    name: file.name,
    size: file.size,
    date: dateStr,
    moduleName: moduleName || ''
  });
  savePDFLibrary(lib);
  const el = document.getElementById('pdf-library-list');
  if(el) el.innerHTML = renderPDFLibrary();
}

async function createUser() {
  const uid = document.getElementById('new-uid').value.trim();
  const name = document.getElementById('new-name').value.trim();
  const pass = document.getElementById('new-pass').value;
  const unit = document.getElementById('new-unit').value;
  const shift = document.getElementById('new-shift').value;
  const msgEl = document.getElementById('user-msg');

  if(!uid||!name||!pass||!unit||!shift) {
    msgEl.innerHTML='<div class="error-msg">Preencha todos os campos.</div>';
    return;
  }
  if(!validarCPF(uid)) {
    msgEl.innerHTML='<div class="error-msg">❌ CPF inválido. Verifique os dígitos e tente novamente.</div>';
    return;
  }
  if(state.users[uid]) {
    msgEl.innerHTML='<div class="error-msg">❌ Este CPF já possui uma conta cadastrada.</div>';
    return;
  }
  // Block duplicate full name
  const normalizedNewName = name.trim().toLowerCase();
  const dupName = Object.values(state.users).find(
    u => u.name.trim().toLowerCase() === normalizedNewName
  );
  if(dupName) {
    msgEl.innerHTML='<div class="error-msg">❌ Já existe uma conta com o nome <strong>' + name + '</strong>. Verifique se o colaborador já está cadastrado.</div>';
    return;
  }

  const { error: insErr } = await getDB().from('users').insert({
    id:uid, name, password:pass, unit, shift,
    xp:0, streak:0, lives:5, last_active:today(),
    completed_lessons:'[]', is_admin:false, total_accesses:0
  });
  if(insErr) {
    msgEl.innerHTML='<div class="error-msg">❌ Erro ao criar usuário: ' + insErr.message + '</div>';
    return;
  }
  state.users[uid] = {
    id:uid, name, password:pass, unit, shift,
    xp:0, streak:0, lives:5, lastActive:today(),
    completedLessons:[], isAdmin:false
  };
  msgEl.innerHTML='<div style="background:#EAFAF1;border:1px solid var(--green);color:#1E8449;padding:10px 14px;border-radius:8px;font-weight:700;font-size:13px;margin-bottom:10px">✅ Usuário criado com sucesso!</div>';
  renderAdmin();
}

async function deleteUser(uid, name) {
  const displayName = name || uid;
  const confirmed = confirm(
    '⚠️ Excluir conta de ' + displayName + '?\n\n' +
    'CPF: ' + uid + '\n\n' +
    'Todo o progresso e histórico desta conta serão perdidos permanentemente.'
  );
  if(confirmed) {
    await getDB().from('users').delete().eq('id', uid);
    delete state.users[uid];
    showToast('🗑️ Conta de ' + displayName + ' excluída.');
    renderAdmin();
  }
}

function showToast(msg) {
  const toast = document.createElement('div');
  toast.style.cssText = `
    position:fixed; bottom:90px; left:50%; transform:translateX(-50%);
    background:#1A1A1A; color:#fff;
    padding:12px 20px; border-radius:100px;
    font-family:'Nunito',sans-serif; font-size:14px; font-weight:700;
    z-index:9999; white-space:nowrap;
    animation: toastIn 0.3s ease;
  `;
  toast.textContent = msg;
  document.body.appendChild(toast);
  setTimeout(() => {
    toast.style.opacity = '0';
    toast.style.transition = 'opacity 0.3s';
    setTimeout(() => toast.remove(), 300);
  }, 2500);
