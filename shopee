async function adminSaveModules() {
  const btn = document.getElementById('btn-save-modules');
  if(btn) {
    btn.innerHTML = '⏳ Salvando...';
    btn.disabled = true;
    btn.style.background = 'linear-gradient(135deg,#95A5A6,#7F8C8D)';
  }

  // Salva no localStorage imediatamente
  if (!Array.isArray(state.modules)) state.modules = [];
  localStorage.setItem('sa_modules', JSON.stringify(state.modules));
  // Salva o módulo HSE junto
  saveHSEModule();

  // Tenta salvar no Supabase
  let supabaseOk = false;
  try {
    await _supabaseUpsert('modules', JSON.stringify(state.modules));
    supabaseOk = true;
  } catch(e) {
    console.warn('adminSaveModules Supabase error:', e.message);
  }

  if(btn) {
    if(supabaseOk) {
      btn.innerHTML = '✅ Salvo!';
      btn.style.background = 'linear-gradient(135deg,#2ECC71,#27AE60)';
      showToast('💾 Alterações salvas! Todos os usuários verão as mudanças.');
    } else {
      btn.innerHTML = '⚠️ Erro ao sincronizar';
      btn.style.background = 'linear-gradient(135deg,#E67E22,#D35400)';
      showToast('⚠️ Salvo localmente. Verifique a conexão com o Supabase.');
    }
    btn.disabled = false;
    setTimeout(() => { btn.innerHTML = '💾 Salvar Alterações'; btn.style.background = ''; }, 3000);
  }

  renderHome();
}
window.adminSaveModules = adminSaveModules;

// ── Renovação automática de vidas durante a sessão ──────────────────────────
// Verifica a cada minuto se o dia virou enquanto o usuário está logado.
// Garante que as vidas sejam renovadas mesmo sem logout/login.
(function startDailyLivesRenewal() {
  setInterval(async function checkDailyLivesRenewal() {
    const u = state.currentUser;
    if (!u || !u.id) return; // nenhum usuário logado

    const todayDate = today();
    if (u.livesDate && u.livesDate !== todayDate) {
      // Novo dia detectado com usuário ainda na sessão → renova as vidas
      u.lives = 5;
      u.livesDate = todayDate;
      await saveUser(u);

      // Atualiza o contador de vidas no topo da tela
      const navLives = document.getElementById('nav-lives');
      if (navLives) navLives.textContent = 5;

      // Se o banner de "sem vidas" estiver visível, esconde-o
      const noLivesBanner = document.getElementById('no-lives-banner');
      if (noLivesBanner) noLivesBanner.remove();

      // Fecha o modal de sem vidas, se aberto
      const noLivesModal = document.getElementById('modal-no-lives');
      if (noLivesModal) noLivesModal.classList.add('hidden');

      showToast('❤️ Suas vidas foram renovadas! Bom estudo!');
    }
  }, 60 * 1000); // verifica a cada 1 minuto
})();
