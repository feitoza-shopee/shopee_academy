          <button onclick="adminClearAllQuestions_HSE(${lessonIdx})" style="background:#FFF0EE;border:1.5px solid #FFCCC4;color:var(--shopee-dark);border-radius:8px;padding:6px 12px;font-size:12px;font-weight:800;cursor:pointer;font-family:'Nunito',sans-serif;">🗑️ Limpar Todas as Perguntas</button>
        </div>
        <div id="hse-q-list-${lessonIdx}">
          ${renderHSEQuestionList(lessonIdx)}
        </div>
      </div>
    </div>
  `;
  document.body.appendChild(overlay);
