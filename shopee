        <td style="padding:10px 8px;font-size:12px;color:var(--text2);">${u.shift||''}</td>
        <td style="padding:10px 8px;font-size:12px;color:var(--text2);">${u.position||''}</td>
        <td style="padding:10px 8px;font-size:13px;font-weight:800;color:var(--gold);">⭐ ${u.xp||0}</td>
