  const color = document.getElementById('adm-mod-color').value;
  const msg   = document.getElementById('adm-mod-msg');

  if(!title) { msg.innerHTML='<div class="error-msg">Informe o nome do módulo.</div>'; return; }

  const mod = { id:'mod_'+Date.now(), title, description:desc||title, icon, color, lessons:[] };
