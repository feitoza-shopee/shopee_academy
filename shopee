<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shopee Academy</title>
<link rel="manifest" href="#" />
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Fredoka+One&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --shopee: #EE4D2D;
  --shopee-dark: #C73E25;
  --shopee-light: #FF7355;
  --orange-glow: rgba(238,77,45,0.3);
  --bg: #FFF8F6;
  --bg2: #FFFFFF;
  --text: #1A1A1A;
  --text2: #666;
  --border: #F0E0DC;
  --gold: #F5A623;
  --silver: #9B9B9B;
  --bronze: #CD7F32;
  --green: #2ECC71;
  --blue: #3498DB;
  --purple: #9B59B6;
  --card: #FFFFFF;
  --shadow: 0 4px 20px rgba(238,77,45,0.12);
  --radius: 16px;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  font-family:'Nunito',sans-serif;
  background:var(--bg);
  color:var(--text);
  min-height:100vh;
  overflow-x:hidden;
}

/* ===== UTILITIES ===== */
.hidden { display:none !important; }
.flex { display:flex; }
.col { flex-direction:column; }
.center { align-items:center; justify-content:center; }
.gap4 { gap:4px; } .gap8 { gap:8px; } .gap12 { gap:12px; } .gap16 { gap:16px; }
.w100 { width:100%; }
.bold { font-weight:800; }
.text-center { text-align:center; }

/* ===== SCREEN SYSTEM ===== */
.screen { display:none; min-height:100vh; }
.screen.active { display:flex; flex-direction:column; height:100vh; overflow:hidden; }

/* ===== LOGIN SCREEN ===== */
#screen-login {
  background: linear-gradient(145deg, #EE4D2D 0%, #FF7355 40%, #FFB347 100%);
  align-items:center;
  justify-content:flex-start;
  padding:24px;
  position:relative;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
}
#screen-login::before {
  content:'';
  position:absolute;
  width:500px; height:500px;
  border-radius:50%;
  background:rgba(255,255,255,0.08);
  top:-150px; right:-150px;
}
#screen-login::after {
  content:'';
  position:absolute;
  width:300px; height:300px;
  border-radius:50%;
  background:rgba(255,255,255,0.06);
  bottom:-100px; left:-80px;
}

.login-card {
  background:#fff;
  border-radius:24px;
  padding:40px 32px;
  width:100%; max-width:420px;
  box-shadow:0 24px 60px rgba(0,0,0,0.2);
  position:relative; z-index:1;
  animation: slideUp 0.5s ease;
  margin:24px 0;
}

@keyframes slideUp {
  from { transform:translateY(30px); opacity:0; }
  to { transform:translateY(0); opacity:1; }
}

.login-logo {
  text-align:center;
  margin-bottom:28px;
}
.login-logo .logo-icon {
  width:80px; height:80px;
  background:linear-gradient(135deg,#EE4D2D,#FF7355);
  border-radius:20px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  font-size:40px;
  margin-bottom:12px;
  box-shadow:0 8px 24px rgba(238,77,45,0.4);
}
.login-logo h1 {
  font-family:'Fredoka One',sans-serif;
  font-size:28px;
  color:var(--shopee);
  letter-spacing:1px;
}
.login-logo p { color:var(--text2); font-size:14px; margin-top:4px; }

.form-group { margin-bottom:16px; }
.form-group label {
  display:block;
  font-weight:700;
  font-size:13px;
  color:var(--text2);
  margin-bottom:6px;
  text-transform:uppercase;
  letter-spacing:0.5px;
}
.form-group input, .form-group select {
  width:100%;
  padding:14px 16px;
  border:2px solid var(--border);
  border-radius:12px;
  font-family:'Nunito',sans-serif;
  font-size:15px;
  font-weight:600;
  color:var(--text);
  background:#fff;
  transition:border-color 0.2s, box-shadow 0.2s;
  outline:none;
  appearance:none;
}
.form-group input:focus, .form-group select:focus {
  border-color:var(--shopee);
  box-shadow:0 0 0 3px var(--orange-glow);
}

.btn-primary {
  width:100%;
  padding:16px;
  background:linear-gradient(135deg,var(--shopee),var(--shopee-light));
  color:#fff;
  border:none;
  border-radius:12px;
  font-family:'Nunito',sans-serif;
  font-size:16px;
  font-weight:800;
  cursor:pointer;
  transition:transform 0.15s, box-shadow 0.15s;
  box-shadow:0 6px 20px rgba(238,77,45,0.4);
  letter-spacing:0.5px;
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(238,77,45,0.5); }
.btn-primary:active { transform:translateY(0); }

.error-msg {
  background:#FFF0EE;
  border:1px solid #FFCCC4;
  color:var(--shopee-dark);
  padding:10px 14px;
  border-radius:8px;
  font-size:13px;
  font-weight:700;
  margin-bottom:14px;
  text-align:center;
}

/* ===== TOP NAV ===== */
.top-nav {
  background:#fff;
  border-bottom:2px solid var(--border);
  padding:12px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky; top:0; z-index:100;
  box-shadow:0 2px 12px rgba(238,77,45,0.08);
}
.nav-logo {
  font-family:'Fredoka One',sans-serif;
  font-size:22px;
  color:var(--shopee);
  display:flex; align-items:center; gap:8px;
}
.nav-stats {
  display:flex; align-items:center; gap:16px;
}
.stat-pill {
  display:flex; align-items:center; gap:5px;
  background:var(--bg);
  border-radius:20px;
  padding:6px 12px;
  font-size:14px; font-weight:800;
}
.stat-pill .icon { font-size:16px; }

/* ===== BOTTOM NAV ===== */
.bottom-nav {
  position:fixed; bottom:0; left:0; right:0;
  background:#fff;
  border-top:2px solid var(--border);
  display:flex;
  z-index:100;
  box-shadow:0 -4px 20px rgba(0,0,0,0.08);
}
.nav-item {
  flex:1;
  display:flex; flex-direction:column;
  align-items:center;
  padding:10px 4px 14px;
  cursor:pointer;
  border:none; background:transparent;
  color:var(--text2);
  font-family:'Nunito',sans-serif;
  font-size:10px; font-weight:700;
  letter-spacing:0.3px;
  transition:color 0.2s;
  position:relative;
}
.nav-item.active { color:var(--shopee); }
.nav-item .nav-icon { font-size:22px; margin-bottom:2px; }
.nav-item.active::after {
  content:'';
  position:absolute;
  top:0; left:50%;
  transform:translateX(-50%);
  width:32px; height:3px;
  background:var(--shopee);
  border-radius:0 0 4px 4px;
}

/* ===== PAGE WRAPPER ===== */
#page-admin {
  min-height:calc(100vh - 160px);
}

.page-content {
  flex:1;
  padding:20px;
  padding-bottom:100px;
  max-width:600px;
  margin:0 auto;
  width:100%;
  overflow-y:auto;
}

/* ===== HOME / MODULES ===== */
.greeting {
  margin-bottom:20px;
}
.greeting h2 {
  font-size:22px; font-weight:900;
  color:var(--text);
}
.greeting p { color:var(--text2); font-size:14px; font-weight:600; }

.streak-banner {
  background:linear-gradient(135deg,#FF7355,var(--shopee));
  border-radius:16px;
  padding:16px 20px;
  color:#fff;
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:24px;
  box-shadow:var(--shadow);
}
.streak-banner .streak-icon { font-size:36px; }
.streak-banner h3 { font-size:18px; font-weight:900; }
.streak-banner p { font-size:13px; opacity:0.9; font-weight:600; }

.section-title {
  font-size:16px; font-weight:900;
  color:var(--text);
  margin-bottom:12px;
  display:flex; align-items:center; gap:8px;
}

.module-card {
  background:var(--card);
  border-radius:var(--radius);
  padding:20px;
  margin-bottom:16px;
  border:2px solid var(--border);
  cursor:pointer;
  transition:transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  position:relative;
  overflow:hidden;
}
.module-card:hover {
  transform:translateY(-3px);
  box-shadow:var(--shadow);
  border-color:var(--shopee);
}
.module-card.locked {
  opacity:0.6;
  cursor:not-allowed;
  filter:grayscale(0.4);
}
.module-card .module-header {
  display:flex; align-items:center; gap:12px;
  margin-bottom:12px;
}
.module-icon {
  width:52px; height:52px;
  border-radius:14px;
  display:flex; align-items:center; justify-content:center;
  font-size:26px;
  flex-shrink:0;
}
.module-card h3 { font-size:16px; font-weight:900; }
.module-card .module-desc { font-size:13px; color:var(--text2); font-weight:600; }

.progress-bar-wrap {
  background:var(--bg);
  border-radius:100px;
  height:10px;
  overflow:hidden;
  margin-top:12px;
}
.progress-bar-fill {
  height:100%;
  border-radius:100px;
  background:linear-gradient(90deg,var(--shopee),var(--shopee-light));
  transition:width 0.8s ease;
}

.badge-complete {
  position:absolute; top:12px; right:12px;
  background:var(--green);
  color:#fff;
  font-size:11px; font-weight:800;
  padding:3px 8px;
  border-radius:100px;
  letter-spacing:0.5px;
}
.badge-locked {
  position:absolute; top:12px; right:12px;
  font-size:18px;
}

/* ===== LESSON LIST ===== */
.back-btn {
  display:flex; align-items:center; gap:6px;
  background:none; border:none;
  font-family:'Nunito',sans-serif;
  font-size:15px; font-weight:800;
  color:var(--shopee);
  cursor:pointer;
  padding:8px 0;
  margin-bottom:16px;
}

.lesson-card {
  background:var(--card);
  border-radius:var(--radius);
  padding:16px 20px;
  margin-bottom:12px;
  border:2px solid var(--border);
  display:flex; align-items:center; gap:14px;
  cursor:pointer;
  transition:transform 0.2s, box-shadow 0.2s, border-color 0.2s;
}
.lesson-card:hover {
  transform:translateX(4px);
  border-color:var(--shopee);
  box-shadow:var(--shadow);
}
.lesson-card.locked {
  opacity:0.55;
  cursor:not-allowed;
}
.lesson-num {
  width:44px; height:44px;
  border-radius:12px;
  background:linear-gradient(135deg,var(--shopee),var(--shopee-light));
  color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:16px; font-weight:900;
  flex-shrink:0;
}
.lesson-num.done {
  background:var(--green);
}
.lesson-num.locked-icon {
  background:var(--border);
  color:var(--text2);
}
.lesson-info { flex:1; }
.lesson-info h4 { font-size:15px; font-weight:800; }
.lesson-info p { font-size:12px; color:var(--text2); font-weight:600; margin-top:2px; }
.lesson-xp {
  font-size:13px; font-weight:800;
  color:var(--gold);
  background:#FFF8E1;
  padding:4px 10px;
  border-radius:100px;
}

/* ===== QUIZ SCREEN ===== */
#screen-quiz {
  background:var(--bg);
}
.quiz-header {
  background:#fff;
  padding:16px 20px;
  display:flex; align-items:center; gap:12px;
  border-bottom:2px solid var(--border);
  position:sticky; top:0; z-index:10;
}
.quiz-close {
  background:none; border:none;
  font-size:24px; cursor:pointer;
  color:var(--text2);
  padding:4px;
  line-height:1;
}
.quiz-progress-wrap {
  flex:1;
  background:var(--bg);
  border-radius:100px;
  height:12px;
  overflow:hidden;
}
.quiz-progress-fill {
  height:100%;
  border-radius:100px;
  background:linear-gradient(90deg,var(--shopee),var(--shopee-light));
  transition:width 0.4s ease;
}
.quiz-lives {
  display:flex; gap:4px;
}
.heart { font-size:20px; }

.quiz-body {
  flex:1;
  padding:24px 20px 100px;
  max-width:600px;
  margin:0 auto;
  width:100%;
}

.question-type-badge {
  display:inline-block;
  background:var(--shopee);
  color:#fff;
  font-size:11px; font-weight:800;
  padding:4px 12px;
  border-radius:100px;
  letter-spacing:1px;
  text-transform:uppercase;
  margin-bottom:16px;
}

.question-text {
  font-size:20px; font-weight:900;
  color:var(--text);
  line-height:1.4;
  margin-bottom:28px;
}

/* Multiple Choice */
.choices-grid {
  display:flex; flex-direction:column; gap:10px;
}
.choice-btn {
  width:100%;
  padding:16px 20px;
  background:#fff;
  border:2.5px solid var(--border);
  border-radius:14px;
  font-family:'Nunito',sans-serif;
  font-size:15px; font-weight:700;
  color:var(--text);
  cursor:pointer;
  text-align:left;
  display:flex; align-items:center; gap:12px;
  transition:all 0.15s;
  position:relative;
}
.choice-btn:hover:not(:disabled) {
  border-color:var(--shopee);
  background:#FFF8F6;
  transform:translateX(4px);
}
.choice-btn.selected {
  border-color:var(--blue);
  background:#EBF5FB;
  color:var(--blue);
}
.choice-btn.correct {
  border-color:var(--green);
  background:#EAFAF1;
  color:#1E8449;
}
.choice-btn.wrong {
  border-color:#E74C3C;
  background:#FDEDEC;
  color:#C0392B;
}
.choice-letter {
  width:32px; height:32px;
  border-radius:8px;
  background:var(--bg);
  display:flex; align-items:center; justify-content:center;
  font-size:13px; font-weight:900;
  flex-shrink:0;
}

/* True/False */
.tf-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:12px;
}
.tf-btn {
  padding:24px 16px;
  border:2.5px solid var(--border);
  border-radius:16px;
  background:#fff;
  font-family:'Nunito',sans-serif;
  font-size:18px; font-weight:900;
  cursor:pointer;
  display:flex; flex-direction:column;
  align-items:center; gap:8px;
  transition:all 0.15s;
}
.tf-btn:hover:not(:disabled) {
  border-color:var(--shopee);
  background:#FFF8F6;
  transform:translateY(-3px);
}
.tf-btn .tf-icon { font-size:40px; }
.tf-btn.selected { border-color:var(--blue); background:#EBF5FB; }
.tf-btn.correct { border-color:var(--green); background:#EAFAF1; }
.tf-btn.wrong { border-color:#E74C3C; background:#FDEDEC; }

/* Order Steps */
.order-instruction {
  font-size:13px; color:var(--text2); font-weight:700;
  margin-bottom:14px;
  background:var(--bg);
  padding:10px 14px;
  border-radius:10px;
}
.order-items {
  display:flex; flex-direction:column; gap:8px;
  margin-bottom:16px;
}
.order-item {
  background:#fff;
  border:2.5px solid var(--border);
  border-radius:12px;
  padding:14px 16px;
  display:flex; align-items:center; gap:10px;
  cursor:grab;
  font-size:14px; font-weight:700;
  transition:all 0.15s;
  user-select:none;
}
.order-item:hover { border-color:var(--shopee); box-shadow:0 4px 12px rgba(238,77,45,0.1); }
.order-item.dragging { opacity:0.5; transform:scale(0.98); }
.order-item.correct-pos { border-color:var(--green); background:#EAFAF1; }
.order-item.wrong-pos { border-color:#E74C3C; background:#FDEDEC; }
.drag-handle { font-size:18px; color:var(--text2); cursor:grab; }
.order-num {
  width:28px; height:28px;
  border-radius:8px;
  background:var(--shopee);
  color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:13px; font-weight:900;
  flex-shrink:0;
}

/* Quiz Footer */
.quiz-footer {
  position:fixed; bottom:0; left:0; right:0;
  background:#fff;
  border-top:2px solid var(--border);
  padding:16px 20px;
  display:flex; flex-direction:column; gap:10px;
}
.quiz-footer.correct-state { background:#EAFAF1; border-color:var(--green); }
.quiz-footer.wrong-state { background:#FDEDEC; border-color:#E74C3C; }

.feedback-row {
  display:flex; align-items:center; gap:10px;
}
.feedback-icon { font-size:28px; }
.feedback-text h4 { font-size:15px; font-weight:900; }
.feedback-text p { font-size:13px; color:var(--text2); font-weight:600; }

.btn-check {
  width:100%;
  padding:16px;
  border:none;
  border-radius:12px;
  font-family:'Nunito',sans-serif;
  font-size:16px; font-weight:900;
  cursor:pointer;
  transition:all 0.15s;
  letter-spacing:0.5px;
}
.btn-check.primary-action {
  background:linear-gradient(135deg,var(--shopee),var(--shopee-light));
  color:#fff;
  box-shadow:0 6px 20px rgba(238,77,45,0.35);
}
.btn-check.primary-action:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(238,77,45,0.5); }
.btn-check:disabled {
  background:#E0E0E0;
  color:#999;
  cursor:not-allowed;
  box-shadow:none;
}

/* ===== RESULT SCREEN ===== */
#screen-result {
  align-items:center;
  justify-content:center;
  padding:24px;
  background:linear-gradient(145deg,#FFF8F6,#FFE8E0);
}
.result-card {
  background:#fff;
  border-radius:24px;
  padding:40px 28px;
  width:100%; max-width:420px;
  text-align:center;
  box-shadow:0 20px 60px rgba(238,77,45,0.15);
  animation:slideUp 0.5s ease;
}
.result-trophy { font-size:80px; margin-bottom:16px; animation:bounce 0.8s ease; }
@keyframes bounce {
  0%,100%{transform:translateY(0);}
  30%{transform:translateY(-20px);}
  60%{transform:translateY(-10px);}
}
.result-card h2 { font-family:'Fredoka One',sans-serif; font-size:32px; color:var(--shopee); margin-bottom:8px; }
.result-card p { color:var(--text2); font-size:15px; font-weight:600; margin-bottom:28px; }
.result-stats {
  display:grid; grid-template-columns:repeat(3,1fr); gap:12px;
  margin-bottom:28px;
}
.result-stat {
  background:var(--bg);
  border-radius:12px;
  padding:14px 8px;
}
.result-stat .rs-value {
  font-size:22px; font-weight:900;
  color:var(--shopee);
}
.result-stat .rs-label {
  font-size:11px; color:var(--text2); font-weight:700;
  text-transform:uppercase; letter-spacing:0.5px;
  margin-top:2px;
}

/* ===== RANKING SCREEN ===== */
.tabs-row {
  display:flex; gap:8px;
  margin-bottom:20px;
  overflow-x:auto;
  padding-bottom:4px;
}
.tab-btn {
  padding:8px 16px;
  border-radius:100px;
  border:2px solid var(--border);
  background:#fff;
  font-family:'Nunito',sans-serif;
  font-size:13px; font-weight:800;
  cursor:pointer;
  white-space:nowrap;
  transition:all 0.2s;
  color:var(--text2);
}
.tab-btn.active {
  background:var(--shopee);
  border-color:var(--shopee);
  color:#fff;
  box-shadow:0 4px 14px rgba(238,77,45,0.3);
}

.ranking-list { display:flex; flex-direction:column; gap:10px; }
.ranking-item {
  background:#fff;
  border-radius:14px;
  padding:14px 16px;
  display:flex; align-items:center; gap:12px;
  border:2px solid var(--border);
  transition:all 0.2s;
}
.ranking-item.me {
  border-color:var(--shopee);
  background:#FFF8F6;
  box-shadow:0 4px 16px rgba(238,77,45,0.12);
}
.rank-pos {
  width:36px; height:36px;
  border-radius:10px;
  display:flex; align-items:center; justify-content:center;
  font-size:16px; font-weight:900;
  flex-shrink:0;
}
.rank-pos.gold { background:#FEF9E7; color:var(--gold); }
.rank-pos.silver { background:#F2F3F4; color:var(--silver); }
.rank-pos.bronze { background:#FDF2E9; color:var(--bronze); }
.rank-pos.other { background:var(--bg); color:var(--text2); font-size:14px; }
.rank-avatar {
  width:44px; height:44px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--shopee),var(--shopee-light));
  color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:18px; font-weight:900;
  flex-shrink:0;
}
.rank-info { flex:1; }
.rank-info h4 { font-size:14px; font-weight:800; }
.rank-info p { font-size:12px; color:var(--text2); font-weight:600; }
.rank-xp {
  font-size:14px; font-weight:900;
  color:var(--gold);
}

/* ===== PROFILE SCREEN ===== */
.profile-hero {
  background:linear-gradient(135deg,var(--shopee),var(--shopee-light));
  border-radius:20px;
  padding:24px;
  color:#fff;
  text-align:center;
  margin-bottom:20px;
