function getPDFLibrary() {
  try {
    const lib = JSON.parse(localStorage.getItem('sa_pdf_library') || 'null');
    if(lib !== null) return lib;
    // Pre-populate with PDFs already used to build the app
    const defaults = [
      { name:'RECEBIMENTO_-_SOC.pdf', size:2800000, date:'21/03/2026 17:00', moduleName:'Recebimento - SOC' },
      { name:'SORTING_E_PACKING.pdf', size:3100000, date:'21/03/2026 17:00', moduleName:'Sorting e Packing - SOC' }
    ];
    localStorage.setItem('sa_pdf_library', JSON.stringify(defaults));
    return defaults;
  }
  catch(e) { return []; }
}
function savePDFLibrary(lib) {
  localStorage.setItem('sa_pdf_library', JSON.stringify(lib));
}

function renderPDFLibrary() {
  const lib = getPDFLibrary();
  if(lib.length === 0) {
    return `
      <div style="text-align:center;padding:24px 0;color:var(--text2);">
        <div style="font-size:36px;margin-bottom:8px;">📭</div>
