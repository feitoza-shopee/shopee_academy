      <div style="display:flex;gap:8px;">
        <input type="text" id="users-search-input" placeholder="Nome, CPF ou apelido... (ENTER para buscar)" value="${searchQuery}"
          style="flex:1;padding:10px 14px;border:2px solid var(--border);border-radius:10px;font-family:Nunito,sans-serif;font-size:14px;font-weight:600;outline:none;" />
