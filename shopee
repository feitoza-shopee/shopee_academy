async function searchReport() {
  const inputEl = document.getElementById('report-search-input');
  const term = (inputEl.value || '').trim();
  const resultsEl = document.getElementById('report-results');
  if(!term) {
    resultsEl.innerHTML = '<p style="color:var(--text2);font-size:13px;text-align:center;padding:16px;">Digite um CPF ou nome para buscar.</p>';
    return;
  }
  resultsEl.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text2);font-weight:700;">🔄 Buscando...</div>';

  // Garante que a lista de colaboradores está atualizada
  const { data: usersData } = await getDB().from('users').select('*');
  (usersData || []).forEach(row => { state.users[row.id] = rowToUser(row); });
  const allUsers = Object.values(state.users).filter(u => !u.isAdmin);

  const cleanTerm = term.replace(/[.\-\/\s]/g, '');
  const isCpfLike = /^\d+$/.test(cleanTerm) && cleanTerm.length >= 6;

  let matches = [];
  if(isCpfLike) {
    matches = allUsers.filter(u => (u.id || '').replace(/[.\-\/\s]/g, '').includes(cleanTerm));
  }
  if(matches.length === 0) {
    const termLower = term.toLowerCase();
    matches = allUsers.filter(u =>
      (u.name || '').toLowerCase().includes(termLower) ||
      (u.nickname || '').toLowerCase().includes(termLower)
    );
  }

  if(matches.length === 0) {
    resultsEl.innerHTML = '<p style="color:var(--text2);font-size:13px;text-align:center;padding:16px;background:#fff;border-radius:16px;border:2px solid var(--border);">❌ Nenhum colaborador encontrado com esse CPF ou nome.</p>';
    return;
  }

  if(matches.length > 1) {
    resultsEl.innerHTML =
      '<div style="background:#fff;border-radius:16px;padding:16px;border:2px solid var(--border);box-shadow:var(--shadow);">' +
        '<div style="font-weight:900;font-size:13px;margin-bottom:10px;color:var(--text);">Vários colaboradores encontrados — selecione:</div>' +
        matches.map(u =>
          '<button onclick="loadReportForUser(\'' + u.id + '\')" style="display:block;width:100%;text-align:left;padding:10px 12px;margin-bottom:6px;background:var(--bg);border:2px solid var(--border);border-radius:10px;font-family:Nunito,sans-serif;cursor:pointer;">' +
            '<div style="font-weight:800;font-size:13px;">' + u.name + '</div>' +
            '<div style="font-size:11px;color:var(--text2);font-weight:600;">' + u.id + ' · ' + (u.unit || '') + ' · ' + (u.shift || '') + '</div>' +
          '</button>'
        ).join('') +
      '</div>';
    return;
  }

  await loadReportForUser(matches[0].id);
}

