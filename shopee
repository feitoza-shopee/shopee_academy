        <div style="font-size:12px;margin-top:4px;">Use a seção acima para importar.</div>
      </div>`;
  }
  return lib.map((pdf, i) => {
    const sizeKB = Math.round((pdf.size || 0) / 1024);
    const sizeLabel = sizeKB > 1024 ? (sizeKB/1024).toFixed(1)+' MB' : sizeKB+' KB';
    return `
      <div style="display:flex;align-items:center;gap:12px;background:var(--bg);border-radius:12px;padding:12px 14px;margin-bottom:8px;border:2px solid var(--border);">
        <div style="font-size:28px;flex-shrink:0;">📄</div>
        <div style="flex:1;min-width:0;">
          <div style="font-weight:800;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${pdf.name}</div>
          <div style="font-size:11px;color:var(--text2);margin-top:2px;">
            ${sizeLabel} &nbsp;·&nbsp; Importado em ${pdf.date}
            ${pdf.moduleName ? `&nbsp;·&nbsp; 📦 <span style="color:var(--shopee);font-weight:700;">${pdf.moduleName}</span>` : ''}
          </div>
        </div>
        <button onclick="deletePDF(${i})" style="flex-shrink:0;background:#FFF0EE;border:2px solid #FFCCC4;color:var(--shopee-dark);border-radius:10px;padding:7px 10px;font-family:'Nunito',sans-serif;font-size:12px;font-weight:800;cursor:pointer;transition:all 0.15s;white-space:nowrap;"
          onmouseover="this.style.background='#E74C3C';this.style.color='#fff';this.style.borderColor='#E74C3C';"
          onmouseout="this.style.background='#FFF0EE';this.style.color='var(--shopee-dark)';this.style.borderColor='#FFCCC4';">
