// ============================================================
// API KEY MANAGEMENT
// ============================================================
function getAPIKey() {
  return localStorage.getItem('sa_api_key') || '';
}

function checkAPIKeyInput() {
  const val = document.getElementById('api-key-input').value.trim();
  const btn = document.getElementById('btn-save-key');
  if(!btn) return;
  // Never disable — always let user try to save; validation happens in saveAPIKey
  btn.disabled = false;
  btn.style.opacity = '1';
}

function toggleAPIKeyVisibility() {
  const input = document.getElementById('api-key-input');
  const btn = document.getElementById('toggle-key-btn');
  if(input.type === 'password') {
    input.type = 'text';
    btn.innerHTML = EYE_CLOSED_SVG;
  } else {
    input.type = 'password';
    btn.innerHTML = EYE_OPEN_SVG;
  }
}

function saveAPIKey() {
  const key = document.getElementById('api-key-input').value.trim();
  if(!key.startsWith('sk-ant-')) {
    document.getElementById('api-key-status').innerHTML =
      '<div class="error-msg">❌ Chave inválida. Deve começar com sk-ant-</div>';
    return;
  }
  localStorage.setItem('sa_api_key', key);
  document.getElementById('api-key-status').innerHTML =
    '<div style="background:#EAFAF1;border:1px solid var(--green);color:#1E8449;padding:10px 14px;border-radius:8px;font-weight:700;font-size:13px;">✅ API Key salva com sucesso!</div>';
  document.getElementById('api-key-input').value = '••••••••' + key.slice(-6);
  document.getElementById('api-key-input').type = 'password';
}

function loadAPIKeyStatus() {
  const key = getAPIKey();
  const statusEl = document.getElementById('api-key-status');
  const inputEl = document.getElementById('api-key-input');
  const btnEl = document.getElementById('btn-save-key');
  if(!statusEl) return;
  // Always keep button enabled
  if(btnEl) { btnEl.disabled = false; btnEl.style.opacity = '1'; }
  if(key) {
    statusEl.innerHTML =
      '<div style="background:#EAFAF1;border:1px solid var(--green);color:#1E8449;padding:10px 14px;border-radius:8px;font-weight:700;font-size:13px;">✅ API Key configurada! Últimos dígitos: ...'+key.slice(-6)+'</div>';
    if(inputEl) { inputEl.placeholder = 'Clique para substituir a chave atual'; }
    if(btnEl) { btnEl.textContent = '🔄 Atualizar API Key'; }
  } else {
    statusEl.innerHTML =
      '<div style="background:#FFF8E1;border:1px solid var(--gold);color:#7D6608;padding:10px 14px;border-radius:8px;font-weight:700;font-size:13px;">⚠️ Nenhuma API Key configurada. A geração de perguntas não funcionará.</div>';
  }
}

// ============================================================
// USERS PANEL — Relatório simplificado
// ============================================================
async function renderUsersPanel() {
  const pageEl = document.getElementById('page-users');
  if(!pageEl) return;

  // Lê os filtros e a busca ANTES de limpar a tela (preserva o que o usuário já digitou/selecionou)
  const filterDateFrom = document.getElementById('users-filter-date-from') ? document.getElementById('users-filter-date-from').value : '';
  const filterDateTo   = document.getElementById('users-filter-date-to')   ? document.getElementById('users-filter-date-to').value   : '';
  const filterShift    = document.getElementById('users-filter-shift')     ? document.getElementById('users-filter-shift').value     : '';
  const filterUnit     = document.getElementById('users-filter-unit')      ? document.getElementById('users-filter-unit').value      : '';
  const filterPosition = document.getElementById('users-filter-position')  ? document.getElementById('users-filter-position').value  : '';
  // searchQuery vem de um campo escondido que só é atualizado quando o usuário pressiona ENTER (ver wireUsersSearchInput)
  const searchQuery    = state._usersSearchQuery || '';

  pageEl.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text2);font-weight:700;">🔄 Carregando usuários...</div>';

  const { data: usersData } = await getDB().from('users').select('*');
  (usersData || []).forEach(row => { state.users[row.id] = rowToUser(row); });
  const allUsers = Object.values(state.users).filter(u => !u.isAdmin);

  const units  = [...new Set(allUsers.map(u => u.unit))].sort();
  const shifts = ['T1','T2','T3','ADM'];

  let filtered = allUsers;
  if(filterDateFrom) filtered = filtered.filter(u => u.lastActive >= filterDateFrom);
  if(filterDateTo)   filtered = filtered.filter(u => u.lastActive <= filterDateTo);
  if(filterShift)    filtered = filtered.filter(u => u.shift    === filterShift);
  if(filterUnit)     filtered = filtered.filter(u => u.unit     === filterUnit);
  if(filterPosition) filtered = filtered.filter(u => u.position === filterPosition);
  if(searchQuery)    filtered = filtered.filter(u =>
    u.name.toLowerCase().includes(searchQuery) ||
    u.id.toLowerCase().includes(searchQuery) ||
    (u.nickname||'').toLowerCase().includes(searchQuery)
  );

  const hasActiveFilter = filterDateFrom || filterDateTo || filterShift || filterUnit || filterPosition || searchQuery;

  // % de perguntas acertadas no módulo "Prova — Avaliação de Conhecimentos HSE" (mod_prova)
  const hseMod = state.modules.find(m => m.id === 'mod_prova');
  // % HSE calculado pelo peso de cada PERGUNTA, não pelo peso de cada lição.
  // Ex.: módulo com 64 perguntas no total -> cada pergunta vale 100/64 = 1,5625%.
  // Assim, lições com mais perguntas pesam proporcionalmente mais na % final.
  const hseTotalQuestions = hseMod && hseMod.lessons
    ? hseMod.lessons.reduce((acc, l) => acc + (l.questions ? l.questions.length : 0), 0)
    : 0;
  const hsePct = (u) => {
    if(!hseMod || !hseMod.lessons || hseMod.lessons.length === 0 || hseTotalQuestions === 0) return 0;
    const doneQuestions = hseMod.lessons
      .filter(l => (u.completedLessons||[]).includes(l.id))
      .reduce((acc, l) => acc + (l.questions ? l.questions.length : 0), 0);
    return Math.round(doneQuestions / hseTotalQuestions * 100);
  };

  const tableRows = filtered
    .sort((a,b) => a.name.localeCompare(b.name))
    .map(u => {
      const pct = hsePct(u);
      const pctColorVal = pct === 100 ? 'var(--green)' : pct > 0 ? 'var(--blue)' : 'var(--text2)';
      const safeName = u.name.replace(/</g,'&lt;');
      const livesVal = (u.lives !== undefined && u.lives !== null) ? u.lives : 5;
      const livesColor = livesVal <= 0 ? '#E74C3C' : livesVal <= 2 ? '#E67E22' : 'var(--green)';
      const livesLabel = livesVal <= 0 ? '💔 0' : '❤️ ' + livesVal;
      return `<tr style="border-bottom:1px solid var(--border);${livesVal <= 0 ? 'background:#FFF8F6;' : ''}">
        <td style="padding:10px 8px;font-size:13px;font-weight:700;">${safeName}</td>
