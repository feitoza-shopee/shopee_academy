  const explanation = document.getElementById('edit-q-explanation').value.trim();
  const msgEl = document.getElementById('edit-q-form-msg');

  if(!qText) { msgEl.innerHTML='<div class="error-msg">Digite a pergunta.</div>'; return; }
  if(!explanation) { msgEl.innerHTML='<div class="error-msg">Adicione uma explicação.</div>'; return; }

  q.q = qText;
  q.explanation = explanation;

  if(q.type==='multiple') {
    const opts = [0,1,2,3].map(i=>(document.getElementById('edit-opt-'+i)||{}).value||'').map(s=>s.trim());
    if(opts.filter(Boolean).length < 2) { msgEl.innerHTML='<div class="error-msg">Preencha pelo menos 2 opções.</div>'; return; }
    const radio = document.querySelector('input[name="edit-correct-opt"]:checked');
    const answer = radio ? parseInt(radio.value) : 0;
    q.options = opts;
    q.answer  = answer;
  } else if(q.type==='truefalse') {
    const tfRadio = document.querySelector('input[name="edit-tf-answer"]:checked');
    q.answer = tfRadio ? tfRadio.value === 'true' : true;
  } else if(q.type==='order') {
    const steps = [0,1,2,3].map(i=>(document.getElementById('edit-step-'+i)||{}).value||'').map(s=>s.trim()).filter(Boolean);
    if(steps.length < 2) { msgEl.innerHTML='<div class="error-msg">Adicione pelo menos 2 etapas.</div>'; return; }
    q.steps = steps;
    q.correctOrder = steps.map((_,i)=>i);
  }

  saveModules();

  // Refresh lists
  const listEl = document.getElementById('q-list-'+lessonId);
  if(listEl) listEl.innerHTML = renderQuestionList(mod, lesson);
  const modListEl = document.getElementById('adm-modules-list');
  if(modListEl) modListEl.innerHTML = renderAdminModulesList();

  // Update overlay header count in the parent editor overlay
  const editorOverlay = document.getElementById('q-editor-overlay');
  if(editorOverlay) {
    const headerCount = editorOverlay.querySelector('div[style*="opacity:0.8"]');
    if(headerCount) headerCount.textContent = `${lesson.questions.length} pergunta(s) · ${lesson.xpReward} XP`;
  }

  // Close edit overlay
  const editOverlay = document.getElementById('q-edit-overlay');
  if(editOverlay) editOverlay.remove();

  showToast('✅ Pergunta atualizada!');
  renderHome();
}

