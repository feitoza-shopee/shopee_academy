async function grantAdmin() {
  const cpf = document.getElementById('grant-admin-cpf').value.trim();
  const msgEl = document.getElementById('grant-admin-msg');

  if(!validarCPF(cpf)) {
    msgEl.innerHTML = '<div class="error-msg">❌ CPF inválido.</div>';
    return;
  }

  const { data: row } = await getDB().from('users').select('*').eq('id', cpf).single();
  if(!row) {
    msgEl.innerHTML = '<div class="error-msg">❌ Colaborador não encontrado.</div>';
    return;
  }
  if(row.is_admin) {
    msgEl.innerHTML = '<div class="error-msg">⚠️ Este colaborador já é administrador.</div>';
    return;
  }

  const { error } = await getDB().from('users').update({ is_admin: true }).eq('id', cpf);
  if(error) {
    msgEl.innerHTML = '<div class="error-msg">❌ Erro: ' + error.message + '</div>';
    return;
  }

  if(state.users[cpf]) state.users[cpf].isAdmin = true;
  document.getElementById('grant-admin-cpf').value = '';
  msgEl.innerHTML = '<div style="background:#EAFAF1;border:1px solid var(--green);color:#1E8449;padding:8px 12px;border-radius:8px;font-weight:700;font-size:12px;">✅ Acesso admin concedido para <strong>' + row.name + '</strong>!</div>';
  setTimeout(() => renderAdmin(), 1500);
}

async function revokeAdmin(uid, name) {
  if(!confirm('Remover acesso admin de ' + name + '?')) return;

  const { error } = await getDB().from('users').update({ is_admin: false }).eq('id', uid);
  if(error) { alert('Erro: ' + error.message); return; }

  if(state.users[uid]) state.users[uid].isAdmin = false;
  showToast('🛡️ Acesso admin removido de ' + name + '.');
  renderAdmin();
}

