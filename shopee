// ── Relatório Individual: registro de questões erradas por colaborador ────
// Usa a tabela app_config (mesmo padrão de saveModules/saveHSEModule) para
// persistir entre dispositivos, com fallback em localStorage.
function _wrongAnswersKey(userId) {
  return 'wronganswers_' + userId;
}

async function saveUserWrongAnswer(userId, entry) {
  const lsKey = 'sa_' + _wrongAnswersKey(userId);
  let list = [];
  try { list = JSON.parse(localStorage.getItem(lsKey) || '[]'); if(!Array.isArray(list)) list = []; } catch(e) { list = []; }
  list.push(entry);
  try { localStorage.setItem(lsKey, JSON.stringify(list)); } catch(e) {}
  try {
    await _supabaseUpsert(_wrongAnswersKey(userId), JSON.stringify(list));
  } catch(e) {
    console.warn('Não foi possível sincronizar o relatório individual com o Supabase:', e.message);
  }
}

async function loadUserWrongAnswers(userId) {
  // 1) Tenta Supabase primeiro (dados de qualquer dispositivo)
  try {
    const timeoutPromise = new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), 3000));
    const fetchPromise = getDB().from('app_config').select('value').eq('key', _wrongAnswersKey(userId)).single();
    const { data, error } = await Promise.race([fetchPromise, timeoutPromise]);
    if(!error && data && data.value) {
      const parsed = JSON.parse(data.value);
      if(Array.isArray(parsed)) {
        try { localStorage.setItem('sa_' + _wrongAnswersKey(userId), data.value); } catch(e) {}
        return parsed;
      }
    }
  } catch(e) { /* tabela ainda não existe, timeout, ou sem dados — cai no fallback */ }
  // 2) Fallback: localStorage deste navegador
  try {
    const raw = localStorage.getItem('sa_' + _wrongAnswersKey(userId));
    if(raw) { const parsed = JSON.parse(raw); if(Array.isArray(parsed)) return parsed; }
  } catch(e) {}
  return [];
}

function showFeedback(correct, explanation) {
  const footer = document.getElementById('quiz-footer');
  footer.className = 'quiz-footer ' + (correct?'correct-state':'wrong-state');

  const isLast = state.quiz.current >= state.quiz.questions.length - 1;
  const noLives = state.quiz.lives <= 0;
  const isProva = isProvaModule();

  // Regra do módulo Prova: ao errar (e ainda com vidas), não avança e não revela a
  // resposta certa — apenas pede para tentar de novo na mesma questão.
  const isProvaRetry = !correct && isProva && !noLives;

  let message = explanation || '';
  if(isProvaRetry) message = 'Você errou, tente novamente.';

  let btnAction, btnLabel;
  if(noLives) {
    btnAction = 'quizFailed()'; btnLabel = 'Ver Resultado';
  } else if(isProvaRetry) {
    btnAction = 'retryQuestion()'; btnLabel = 'Tentar novamente';
  } else if(isLast) {
    btnAction = 'finishQuiz()'; btnLabel = 'Ver Resultado →';
  } else {
    btnAction = 'nextQuestion()'; btnLabel = 'Continuar →';
  }

  footer.innerHTML = `
    <div class="feedback-row">
      <span class="feedback-icon">${correct?'🎉':'💔'}</span>
      <div class="feedback-text">
        <h4 style="color:${correct?'var(--green)':'#E74C3C'}">${correct?'Correto!':'Incorreto!'}</h4>
        <p>${message}</p>
      </div>
    </div>
    <button class="btn-check primary-action" onclick="${btnAction}">
      ${btnLabel}
    </button>
  `;

  // Update lives display
  let livesHtml = '';
  for(let i=0;i<5;i++) {
    livesHtml += `<span class="heart">${i < state.quiz.lives ? '❤️' : '🖤'}</span>`;
  }
  document.getElementById('quiz-lives-display').innerHTML = livesHtml;
}

function nextQuestion() {
  state.quiz.current++;
  if(state.quiz.lives <= 0) { quizFailed(); return; }
  saveQuizProgress();
  renderQuestion();
}

// Repete a mesma questão (usado no módulo Prova quando o jogador erra).
// Não incrementa o índice atual — o jogador só avança ao acertar.
function retryQuestion() {
  if(state.quiz.lives <= 0) { quizFailed(); return; }
  saveQuizProgress();
  renderQuestion();
}

async function finishQuiz() {
  const q = state.quiz;
  const u = state.currentUser;
  const lesson = state.currentLesson;
  const elapsed = Math.round((Date.now() - q.startTime) / 1000);
  const mins = Math.floor(elapsed/60);
  const secs = elapsed%60;

  // Persiste os índices corretos acumulados nesta sessão
  if(Array.isArray(q.correctIndices)) {
    saveCorrectQuestionIndices(lesson.id, q.correctIndices);
  }

  const totalOrig = q.totalQuestions || lesson.questions.length;
  const totalCorrectEver = Array.isArray(q.correctIndices) ? q.correctIndices.length : q.correct;
  const sessionQuestions = q.questions.length;
  const accuracy = sessionQuestions > 0 ? Math.round(q.correct / sessionQuestions * 100) : 0;
  const allDone = totalCorrectEver >= totalOrig;

  // XP proporcional às acertadas nesta sessão, bônus de 50% ao concluir todas
  let xpGained = 0;
  if(!u.isAdmin && q.correct > 0) {
    const base = Math.round((q.correct / totalOrig) * lesson.xpReward);
    const bonus = allDone ? Math.round(lesson.xpReward * 0.5) : 0;
    xpGained = base + bonus;
    u.xp = (u.xp || 0) + xpGained;
  }
  u.lives = q.lives;

  const lessonMinutes = Math.round((Date.now() - q.startTime) / 60000);
  u.totalMinutes = (u.totalMinutes || 0) + lessonMinutes;
  if(!u.isAdmin) {
    u.questionsAnswered = (u.questionsAnswered || 0) + sessionQuestions;
  }

  // Marca lição como concluída quando TODAS as questões originais foram acertadas
  if(allDone && !(u.completedLessons||[]).includes(lesson.id)) {
    if(!u.completedLessons) u.completedLessons = [];
    u.completedLessons.push(lesson.id);
    clearCorrectQuestionIndices(lesson.id);
    const allMods = Array.isArray(state.modules) ? state.modules : [];
    u.completedModules = allMods.filter(m => m.lessons.length > 0 && m.lessons.every(l => u.completedLessons.includes(l.id))).length;
  }

  u.quizProgress = null;
  await saveUser(u);
  clearQuizProgress(lesson.id);
  updateNavStats();

  const pendingAfter = totalOrig - totalCorrectEver;

  document.getElementById('result-trophy').textContent = allDone ? '🏆' : accuracy >= 70 ? '🌟' : '📚';
  document.getElementById('result-title').textContent   = allDone ? 'Perfeito!' : accuracy >= 70 ? 'Quase lá!' : 'Continue Tentando!';
  document.getElementById('result-subtitle').textContent = allDone
    ? 'Lição concluída! A próxima foi desbloqueada. 🔓'
    : pendingAfter > 0
      ? 'Você ganhou XP parcial! Ainda faltam ' + pendingAfter + ' questão(ões) para concluir a lição. Tente novamente!'
      : 'Você precisa acertar ao menos uma questão para ganhar XP. Tente novamente!';
  document.getElementById('result-xp').textContent = '+'+xpGained;
  document.getElementById('result-accuracy').textContent = accuracy+'%';
  document.getElementById('result-time').textContent = mins+':'+(secs<10?'0':'')+secs;

  showScreen('screen-result');
  if(allDone) launchConfetti();
}

async function quizFailed() {
  const u = state.currentUser;
  const q = state.quiz;
  const lesson = state.currentLesson;
  u.lives = 0;
  u.livesDate = today();

  // Persiste os índices corretos acumulados para não perder acertos parciais
  if(q && Array.isArray(q.correctIndices)) {
    saveCorrectQuestionIndices(lesson.id, q.correctIndices);
  }

  if(lesson && q) {
    u.quizProgress = {
      lessonId: lesson.id,
      current: q.current,
      lives: 0,
      errors: q.errors,
      correct: q.correct
    };
  }

  await saveUser(u);
  updateNavStats();

  document.getElementById('result-trophy').textContent = '💔';
  document.getElementById('result-title').textContent = 'Sem Vidas!';
  document.getElementById('result-subtitle').textContent = 'Suas vidas se esgotaram. Volte amanhã — as questões já acertadas não serão repetidas!';
  document.getElementById('result-xp').textContent = '+0';
  document.getElementById('result-accuracy').textContent = '—';
  document.getElementById('result-time').textContent = '—';
  showScreen('screen-result');
}

function closeQuiz() {
  if(confirm('Tem certeza? Seu progresso nesta sessão será salvo, mas questões não acertadas aparecerão novamente.')) {
    // Salva os índices corretos acumulados nesta sessão incompleta
    if(state.quiz && Array.isArray(state.quiz.correctIndices) && state.currentLesson) {
      saveCorrectQuestionIndices(state.currentLesson.id, state.quiz.correctIndices);
      saveQuizProgress();
    }
    showScreen('screen-main');
    switchPage('home');
  }
}

