function renderHSEQuestionList(lessonIdx) {
  const lesson = HSE_MODULE.lessons[lessonIdx];
  if(!lesson || !lesson.questions.length) return '<div style="font-size:12px;color:var(--text2);text-align:center;padding:8px 0;">Nenhuma pergunta ainda.</div>';
  return lesson.questions.map((q, qi) => `
    <div style="background:var(--bg);border-radius:10px;padding:10px 12px;border:1.5px solid var(--border);display:flex;gap:8px;align-items:flex-start;margin-bottom:8px;">
      <div style="background:var(--shopee);color:#fff;border-radius:6px;padding:2px 7px;font-size:10px;font-weight:900;flex-shrink:0;margin-top:1px;">${qi+1}</div>
      <div style="flex:1;min-width:0;">
        <div style="font-size:12px;font-weight:700;line-height:1.4;">${q.q}</div>
        <div style="font-size:10px;color:var(--text2);margin-top:2px;">${q.type==='multiple'?'Múltipla Escolha':q.type==='truefalse'?'V ou F':'Ordenar'}</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:4px;flex-shrink:0;">
        <button onclick="adminEditHSEQuestion(${lessonIdx},${qi})" style="background:#EBF5FB;border:1.5px solid #AED6F1;color:#2471A3;border-radius:6px;padding:4px 7px;font-size:11px;font-weight:800;cursor:pointer;font-family:'Nunito',sans-serif;">✏️</button>
        <button onclick="adminDeleteHSEQuestion(${lessonIdx},${qi})" style="background:#FFF0EE;border:1.5px solid #FFCCC4;color:var(--shopee-dark);border-radius:6px;padding:4px 7px;font-size:11px;font-weight:800;cursor:pointer;font-family:'Nunito',sans-serif;">🗑️</button>
      </div>
    </div>
  `).join('');
}

function adminDeleteHSEQuestion(lessonIdx, qi) {
  const lesson = HSE_MODULE.lessons[lessonIdx];
  if(!lesson) return;
  if(!confirm('Excluir esta pergunta do módulo HSE?')) return;
  lesson.questions.splice(qi, 1);
  saveHSEModule();
  const listEl = document.getElementById('hse-q-list-' + lessonIdx);
  if(listEl) listEl.innerHTML = renderHSEQuestionList(lessonIdx);
  const countEl = document.getElementById('hse-header-count-' + lessonIdx);
  if(countEl) countEl.textContent = lesson.questions.length + ' pergunta(s) · ' + lesson.xpReward + ' XP';
  document.getElementById('adm-modules-list').innerHTML = renderAdminModulesList();
  showToast('🗑️ Pergunta HSE excluída.');
}

function adminEditHSEQuestion(lessonIdx, qi) {
  const lesson = HSE_MODULE.lessons[lessonIdx];
  if(!lesson) return;
  const q = lesson.questions[qi];
  if(!q) return;

  // Reuse the same edit overlay logic as regular modules
  const existing = document.getElementById('q-edit-overlay');
  if(existing) existing.remove();

  let optionsHtml = '';
  if(q.type === 'multiple') {
    optionsHtml = (q.options||[]).map((opt,oi) => `
      <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
        <input type="radio" name="hse-edit-correct" value="${oi}" ${q.answer===oi?'checked':''} style="flex-shrink:0;" />
        <input type="text" id="hse-edit-opt-${oi}" value="${opt.replace(/"/g,'&quot;')}" style="flex:1;padding:8px 10px;border:2px solid var(--border);border-radius:8px;font-family:'Nunito',sans-serif;font-size:13px;" />
      </div>`).join('');
  } else if(q.type === 'truefalse') {
    optionsHtml = `<div style="font-size:13px;font-weight:700;margin-bottom:8px;color:var(--text2);">Resposta Correta:</div>
      <div style="display:flex;gap:8px;">
        <label style="display:flex;align-items:center;gap:6px;font-weight:700;font-size:14px;cursor:pointer;"><input type="radio" name="hse-edit-correct" value="true" ${q.answer===true?'checked':''}> ✅ Verdadeiro</label>
        <label style="display:flex;align-items:center;gap:6px;font-weight:700;font-size:14px;cursor:pointer;"><input type="radio" name="hse-edit-correct" value="false" ${q.answer===false?'checked':''}> ❌ Falso</label>
      </div>`;
  } else if(q.type === 'order') {
    optionsHtml = (q.steps||[]).map((step,si) => `
      <div style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
        <span style="background:var(--shopee);color:#fff;border-radius:6px;padding:2px 7px;font-size:11px;font-weight:900;flex-shrink:0;">${si+1}</span>
        <input type="text" id="hse-edit-step-${si}" value="${step.replace(/"/g,'&quot;')}" style="flex:1;padding:8px 10px;border:2px solid var(--border);border-radius:8px;font-family:'Nunito',sans-serif;font-size:13px;" />
      </div>`).join('');
  }

  const overlay = document.createElement('div');
  overlay.id = 'q-edit-overlay';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:flex-end;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:#fff;border-radius:20px 20px 0 0;width:100%;max-width:500px;max-height:85vh;overflow-y:auto;box-shadow:0 -8px 40px rgba(0,0,0,0.2);">
      <div style="background:linear-gradient(135deg,#E74C3C,#C0392B);border-radius:20px 20px 0 0;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
        <div style="color:#fff;font-weight:900;font-size:15px;">✏️ Editar Pergunta HSE</div>
        <button onclick="document.getElementById('q-edit-overlay').remove()" style="background:rgba(255,255,255,0.2);border:none;border-radius:8px;padding:6px 10px;color:#fff;font-weight:800;cursor:pointer;font-size:13px;">✕</button>
      </div>
      <div style="padding:16px;">
        <div style="font-size:11px;font-weight:800;color:var(--text2);text-transform:uppercase;margin-bottom:6px;">Pergunta</div>
        <textarea id="hse-edit-q-text" rows="3" style="width:100%;padding:10px 12px;border:2px solid var(--border);border-radius:10px;font-family:'Nunito',sans-serif;font-size:14px;font-weight:600;resize:vertical;">${q.q}</textarea>
        <div style="font-size:11px;font-weight:800;color:var(--text2);text-transform:uppercase;margin-bottom:6px;margin-top:12px;">${q.type==='multiple'?'Opções (marque a correta)':q.type==='truefalse'?'Verdadeiro / Falso':'Etapas (ordem correta)'}</div>
        ${optionsHtml}
        <div style="font-size:11px;font-weight:800;color:var(--text2);text-transform:uppercase;margin-bottom:6px;margin-top:12px;">Explicação</div>
        <textarea id="hse-edit-explanation" rows="2" style="width:100%;padding:10px 12px;border:2px solid var(--border);border-radius:10px;font-family:'Nunito',sans-serif;font-size:13px;font-weight:600;resize:vertical;">${q.explanation||''}</textarea>
        <button onclick="adminSaveHSEQuestionEdit(${lessonIdx},${qi})" style="width:100%;margin-top:14px;padding:14px;background:linear-gradient(135deg,var(--shopee),var(--shopee-light));color:#fff;border:none;border-radius:12px;font-family:'Nunito',sans-serif;font-size:15px;font-weight:900;cursor:pointer;">✅ Salvar Alterações</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
}

function adminSaveHSEQuestionEdit(lessonIdx, qi) {
  const lesson = HSE_MODULE.lessons[lessonIdx];
  if(!lesson) return;
  const q = lesson.questions[qi];
  if(!q) return;

  const newText = document.getElementById('hse-edit-q-text').value.trim();
  if(!newText) { alert('O texto da pergunta não pode estar vazio.'); return; }
  q.q = newText;
  q.explanation = (document.getElementById('hse-edit-explanation').value||'').trim();

  if(q.type === 'multiple') {
    const correctRadio = document.querySelector('input[name="hse-edit-correct"]:checked');
    if(!correctRadio) { alert('Selecione a opção correta.'); return; }
    q.answer = parseInt(correctRadio.value);
    q.options = q.options.map((_,oi) => {
      const inp = document.getElementById('hse-edit-opt-'+oi);
      return inp ? inp.value.trim() : q.options[oi];
    });
  } else if(q.type === 'truefalse') {
    const correctRadio = document.querySelector('input[name="hse-edit-correct"]:checked');
    if(!correctRadio) { alert('Selecione Verdadeiro ou Falso.'); return; }
    q.answer = correctRadio.value === 'true';
  } else if(q.type === 'order') {
    q.steps = q.steps.map((_,si) => {
      const inp = document.getElementById('hse-edit-step-'+si);
      return inp ? inp.value.trim() : q.steps[si];
    });
  }

  document.getElementById('q-edit-overlay').remove();
  const listEl = document.getElementById('hse-q-list-' + lessonIdx);
  if(listEl) listEl.innerHTML = renderHSEQuestionList(lessonIdx);
  saveHSEModule();
  showToast('✅ Pergunta HSE atualizada!');
}

function adminClearAllQuestions_HSE(lessonIdx) {
  const lesson = HSE_MODULE.lessons[lessonIdx];
  if(!lesson) return;
  if(!confirm('Limpar TODAS as ' + lesson.questions.length + ' perguntas desta lição HSE? Esta ação não pode ser desfeita.')) return;
  lesson.questions = [];
  saveHSEModule();
  const listEl = document.getElementById('hse-q-list-' + lessonIdx);
  if(listEl) listEl.innerHTML = renderHSEQuestionList(lessonIdx);
  const countEl = document.getElementById('hse-header-count-' + lessonIdx);
  if(countEl) countEl.textContent = '0 pergunta(s) · ' + lesson.xpReward + ' XP';
  document.getElementById('adm-modules-list').innerHTML = renderAdminModulesList();
  showToast('🧹 Todas as perguntas HSE foram removidas.');
}

// ── Clear all questions for a regular lesson ─────────────────────────────
function adminClearAllQuestions(modId, lessonId) {
  const mod    = state.modules.find(m => m.id === modId);
  const lesson = mod && mod.lessons.find(l => l.id === lessonId);
  if(!mod || !lesson) return;
  if(!confirm('Limpar TODAS as ' + lesson.questions.length + ' perguntas desta lição? Esta ação não pode ser desfeita.')) return;
  lesson.questions = [];
  saveModules();
  const listEl = document.getElementById('q-list-' + lessonId);
  if(listEl) listEl.innerHTML = renderQuestionList(mod, lesson);
  const countEl = document.getElementById('q-header-count-' + lessonId);
  if(countEl) countEl.textContent = '0 pergunta(s) · ' + lesson.xpReward + ' XP';
  document.getElementById('adm-modules-list').innerHTML = renderAdminModulesList();
  renderHome();
  showToast('🧹 Todas as perguntas foram removidas.');
}

