async function saveUser(user) {
  // Backup local da data de renovação de vidas — funciona mesmo se a coluna
  // lives_date ainda não existir no Supabase (evita travar a renovação diária).
  try { localStorage.setItem('sa_livesdate_' + user.id, user.livesDate || ''); } catch(e) {}
  // Backup local das vidas — fallback adicional para diagnóstico
  try { localStorage.setItem('sa_lives_' + user.id, String(user.lives !== undefined ? user.lives : 5)); } catch(e) {}

  const row = {
    id: user.id,
    name: user.name,
    nickname: user.nickname || null,
    password: user.password,
    unit: user.unit,
    shift: user.shift,
    position: user.position || '',
    xp: user.xp || 0,
    streak: user.streak || 0,
    lives: (user.lives !== undefined && user.lives !== null) ? user.lives : 5,
    lives_date: user.livesDate || '',
    last_active: user.lastActive || today(),
    completed_lessons: JSON.stringify(user.completedLessons || []),
    quiz_progress: user.quizProgress ? JSON.stringify(user.quizProgress) : null,
    is_admin: user.isAdmin || false,
    total_accesses: user.totalAccesses || 0
  };
  let { error } = await getDB().from('users').upsert(row, { onConflict: 'id' });
  if(error) {
    console.error('saveUser error — code:', error.code, '| message:', error.message, '| details:', error.details, '| hint:', error.hint, '| full:', JSON.stringify(error));
    // Fallback: se as colunas novas (lives_date / quiz_progress) ainda não existem no banco,
    // tenta salvar sem elas para não perder os dados essenciais (XP, vidas, lições concluídas).
    if(error.code === 'PGRST204' || (error.message && (error.message.includes('lives_date') || error.message.includes('quiz_progress') || error.message.includes('column')))) {
      const fallbackRow = { ...row };
      delete fallbackRow.lives_date;
      delete fallbackRow.quiz_progress;
      const retry = await getDB().from('users').upsert(fallbackRow, { onConflict: 'id' });
      if(retry.error) console.error('saveUser fallback error:', retry.error.message);
      else console.warn('saveUser: salvo sem lives_date/quiz_progress — adicione essas colunas na tabela users no Supabase.');
    }
  }
}
