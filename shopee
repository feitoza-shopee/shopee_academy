      let existing = [];
      try {
        const raw = localStorage.getItem('sa_modules');
        if(raw) existing = JSON.parse(raw);
        if(!Array.isArray(existing)) existing = [];
      } catch(e) {
        console.warn('sa_modules corrompido no localStorage, limpando...', e.message);
        localStorage.removeItem('sa_modules');
        existing = [];
      }
      const adminOnly = existing.filter(m => !pdfModules.some(p => p.id === m.id));
      const merged = [...pdfModules, ...adminOnly];
      state.modules = merged;
      ensureHSEFirst();
      localStorage.setItem('sa_modules', JSON.stringify(state.modules));
      // Tenta persistir no Supabase em background (não bloqueia o boot)
      getDB().from('app_config').upsert({ key: 'modules', value: JSON.stringify(merged) }, { onConflict: 'key' })
        .then(({ error }) => { if(error) console.warn('app_config não disponível ainda:', error.message); })
        .catch(() => {});
    }
    localStorage.setItem('sa_modules_version', PDF_MODULES_VERSION);
  }
}

