// ============================================================
// Liga o listener de ENTER no campo de busca — a busca NUNCA dispara durante digitação,
// ao perder foco (blur) ou ao clicar fora. Só dispara com a tecla Enter ou clique no botão Buscar.
function wireUsersSearchInput() {
  const input = document.getElementById('users-search-input');
  if(!input) return;
  input.addEventListener('keydown', function(e) {
    if(e.key === 'Enter') {
      e.preventDefault();
      triggerUsersSearch();
    }
  });
}

async function triggerUsersSearch() {
  const input = document.getElementById('users-search-input');
  const btn = document.getElementById('users-search-btn');
  if(!input) return;
  const value = input.value.trim().toLowerCase();
  state._usersSearchQuery = value;
  if(btn) { btn.textContent = '⏳'; btn.disabled = true; }
  await renderUsersPanel();
}

function clearUsersSearch() {
  state._usersSearchQuery = '';
  renderUsersPanel();
}

function clearUsersFilters() {
  // Reset all filter elements then re-render
  ['users-filter-date-from','users-filter-date-to','users-filter-shift','users-filter-unit','users-filter-position'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.value = '';
  });
  state._usersSearchQuery = '';
  renderUsersPanel();
}

async function deleteUserFromPanel(uid, name) {
  if(!confirm('Excluir a conta de ' + name + '? Esta ação não pode ser desfeita.')) return;
  const { error } = await getDB().from('users').delete().eq('id', uid);
  if(error) { alert('Erro ao excluir: ' + error.message); return; }
  delete state.users[uid];
  showToast('🗑️ Conta de ' + name + ' excluída.');
  renderUsersPanel();
}

function exportTodayToExcel() {
  const allUsers = Object.values(state.users).filter(u => !u.isAdmin);

  const filterDateFrom = document.getElementById('users-filter-date-from') ? document.getElementById('users-filter-date-from').value : '';
  const filterDateTo   = document.getElementById('users-filter-date-to')   ? document.getElementById('users-filter-date-to').value   : '';
  const filterShift    = document.getElementById('users-filter-shift')     ? document.getElementById('users-filter-shift').value     : '';
  const filterUnit     = document.getElementById('users-filter-unit')      ? document.getElementById('users-filter-unit').value      : '';
  const filterPosition = document.getElementById('users-filter-position')  ? document.getElementById('users-filter-position').value  : '';
  const searchQuery    = state._usersSearchQuery || '';

  let exportUsers = allUsers;
  if(filterDateFrom) exportUsers = exportUsers.filter(u => u.lastActive >= filterDateFrom);
  if(filterDateTo)   exportUsers = exportUsers.filter(u => u.lastActive <= filterDateTo);
  if(filterShift)    exportUsers = exportUsers.filter(u => u.shift    === filterShift);
  if(filterUnit)     exportUsers = exportUsers.filter(u => u.unit     === filterUnit);
  if(filterPosition) exportUsers = exportUsers.filter(u => u.position === filterPosition);
  if(searchQuery)    exportUsers = exportUsers.filter(u =>
    u.name.toLowerCase().includes(searchQuery) ||
    u.id.toLowerCase().includes(searchQuery) ||
    (u.nickname||'').toLowerCase().includes(searchQuery)
  );

  if(exportUsers.length === 0) {
    alert('Nenhum colaborador encontrado com os filtros ativos.');
    return;
  }

  let periodLabel = '';
  if(filterDateFrom && filterDateTo) periodLabel = filterDateFrom + '_a_' + filterDateTo;
  else if(filterDateFrom) periodLabel = 'a-partir-de_' + filterDateFrom;
  else if(filterDateTo)   periodLabel = 'ate_' + filterDateTo;
  else                    periodLabel = today();

  // % de perguntas acertadas no módulo "Prova — Avaliação de Conhecimentos HSE" (mod_prova)
  const hseMod = state.modules.find(m => m.id === 'mod_prova');
  // % HSE calculado pelo peso de cada PERGUNTA, não pelo peso de cada lição.
  // Ex.: módulo com 64 perguntas no total -> cada pergunta vale 100/64 = 1,5625%.
  // Assim, lições com mais perguntas pesam proporcionalmente mais na % final.
  const hseTotalQuestions = hseMod && hseMod.lessons
    ? hseMod.lessons.reduce((acc, l) => acc + (l.questions ? l.questions.length : 0), 0)
    : 0;
  const hsePct = (u) => {
    if(!hseMod || !hseMod.lessons || hseMod.lessons.length === 0 || hseTotalQuestions === 0) return 0;
    const doneQuestions = hseMod.lessons
      .filter(l => (u.completedLessons||[]).includes(l.id))
      .reduce((acc, l) => acc + (l.questions ? l.questions.length : 0), 0);
    return Math.round(doneQuestions / hseTotalQuestions * 100);
  };

  const headers = ['Nome','Unidade','Turno','Cargo','XP','Último Acesso','% Conclusão HSE'];
  const rows = exportUsers.map(u => [u.name, u.unit, u.shift, u.position||'', u.xp||0, u.lastActive, hsePct(u)+'%']);

  const BOM = '﻿';
  const csvContent = BOM + [headers, ...rows]
    .map(r => r.map(v => '"' + String(v).replace(/"/g,'""') + '"').join(';'))
    .join('\n');

  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = 'relatorio_usuarios_' + periodLabel + '.csv';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('📥 Excel exportado: ' + exportUsers.length + ' colaborador(es).');
}


