function saveGeneratedLesson() {
  const modName = document.getElementById('new-mod-name').value.trim();
  const lessonName = document.getElementById('new-lesson-name').value.trim();

  if(!modName||!lessonName) {
    alert('Preencha o nome do módulo e da lição.');
    return;
  }
  if(!state.generatedQuestions.length) {
    alert('Gere as perguntas primeiro.');
    return;
  }

  const newLessonId = 'lesson_'+Date.now();
  const newLesson = {
    id: newLessonId,
    title: lessonName,
    description: 'Gerado via IA a partir de PDF',
    xpReward: 75,
    questions: state.generatedQuestions
  };

  // Check if module exists
  let mod = state.modules.find(m => m.title === modName);
  if(!mod) {
    const icons = ['📋','🎯','💡','⚡','🔄','📊'];
    const colors = ['linear-gradient(135deg,#EE4D2D,#FF7355)','linear-gradient(135deg,#3498DB,#5DADE2)','linear-gradient(135deg,#2ECC71,#58D68D)','linear-gradient(135deg,#9B59B6,#BB8FCE)'];
    mod = {
      id: 'mod_'+Date.now(),
      title: modName,
      description: 'Conteúdo importado via PDF',
      icon: icons[Math.floor(Math.random()*icons.length)],
      color: colors[Math.floor(Math.random()*colors.length)],
      lessons: []
    };
    state.modules.push(mod);
  }

  mod.lessons.push(newLesson);
  saveModules();

  // Register PDF in library
  if(state._pendingPDFFile) {
    registerPDFInLibrary(state._pendingPDFFile, modName);
    state._pendingPDFFile = null;
  }

  alert('✅ Lição "'+lessonName+'" adicionada ao módulo "'+modName+'"!');
  state.generatedQuestions = [];
  renderAdmin();
  renderHome();
}

