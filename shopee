  resultsEl.innerHTML = '<div style="text-align:center;padding:30px;color:var(--text2);font-weight:700;">🔄 Carregando questões erradas...</div>';

  const u = state.users[userId];
  const wrongAnswers = await loadUserWrongAnswers(userId);
  _reportCurrentUser = u;
  _reportSearchResults = wrongAnswers;

  const header =
    '<div style="background:#fff;border-radius:16px;padding:16px;margin-bottom:16px;border:2px solid var(--border);box-shadow:var(--shadow);">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">' +
        '<div>' +
          '<div style="font-weight:900;font-size:16px;">' + (u ? u.name : userId) + '</div>' +
          '<div style="font-size:12px;color:var(--text2);font-weight:700;">' + userId + (u ? (' · ' + (u.unit || '') + ' · ' + (u.shift || '')) : '') + '</div>' +
        '</div>' +
        '<button onclick="exportReportToExcel()" ' + (wrongAnswers.length === 0 ? 'disabled' : '') + ' style="padding:10px 14px;background:linear-gradient(135deg,#27AE60,#2ECC71);color:#fff;border:none;border-radius:10px;font-family:Nunito,sans-serif;font-size:13px;font-weight:800;cursor:pointer;' + (wrongAnswers.length === 0 ? 'opacity:0.5;cursor:not-allowed;' : '') + '">📥 Exportar para Excel</button>' +
      '</div>' +
    '</div>';

  if(wrongAnswers.length === 0) {
    resultsEl.innerHTML = header + '<p style="color:var(--text2);font-size:13px;text-align:center;padding:16px;background:#fff;border-radius:16px;border:2px solid var(--border);">✅ Nenhuma questão errada registrada para este colaborador.</p>';
    return;
  }

  const rows = wrongAnswers.map(w =>
    '<div style="background:#fff;border-radius:14px;padding:14px;margin-bottom:10px;border:2px solid var(--border);box-shadow:var(--shadow);">' +
      '<div style="font-size:11px;color:var(--text2);font-weight:700;margin-bottom:6px;">' + (w.date || '') + ' · ' + (w.modTitle || '') + (w.lessonTitle ? (' → ' + w.lessonTitle) : '') + '</div>' +
      '<div style="font-size:13px;font-weight:800;margin-bottom:8px;">' + (w.question || '') + '</div>' +
      '<div style="font-size:12px;color:#E74C3C;font-weight:700;">❌ Resposta do colaborador: ' + (w.userAnswer || '—') + '</div>' +
      '<div style="font-size:12px;color:var(--green);font-weight:700;">✅ Resposta correta: ' + (w.correctAnswer || '—') + '</div>' +
    '</div>'
  ).join('');

