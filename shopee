async function handleLogin() {
  const uid = document.getElementById('login-user').value.trim();
  const pass = document.getElementById('login-pass').value;
  const unit = document.getElementById('login-unit').value;
  const shift = document.getElementById('login-shift').value;
  const errEl = document.getElementById('login-error');

  if(!uid||!pass||!unit||!shift) {
    errEl.textContent='Preencha todos os campos.';
    errEl.classList.remove('hidden');
    return;
  }

  showLoading('Entrando...');

  // Load fresh user list from Supabase
  const { data: usersData } = await getDB().from('users').select('*');
  state.users = {};
  (usersData || []).forEach(row => { state.users[row.id] = rowToUser(row); });

  const user = state.users[uid];
  if(!user || user.password !== pass) {
    hideLoading();
    errEl.textContent='CPF ou senha incorretos.';
    errEl.classList.remove('hidden');
    return;
  }

  errEl.classList.add('hidden');

  // Update user unit/shift if changed
  user.unit = unit;
  user.shift = shift;

  // Track access count and time
  user.totalAccesses = (user.totalAccesses || 0) + 1;
  user.sessionStart = Date.now();

  // Streak renewal logic (only on new day)
  const lastDate = user.lastActive;
  const todayDate = today();
  if(lastDate !== todayDate) {
    const diff = (new Date(todayDate) - new Date(lastDate)) / (1000*60*60*24);
    if(diff > 1) user.streak = 1;
    else user.streak++;
    user.lastActive = todayDate;
  }

  // Lives renewal: só restaura no PRIMEIRO acesso de um dia novo, baseado em livesDate
  // (livesDate é a data em que as vidas foram usadas/zeradas pela última vez — não a do último login)
  if(!user.livesDate) {
    // livesDate vazio pode significar:
    // (a) primeiro uso do sistema — inicializa com hoje sem restaurar, OU
    // (b) coluna lives_date ausente no Supabase (fallback apagou o valor) — nesse caso
    //     usamos lastActive para detectar se já virou o dia e restauramos as vidas.
    const lastActiveDate = user.lastActive || '';
    if(lastActiveDate && lastActiveDate !== todayDate) {
      // Usuário já acessou antes e é um dia diferente → restaura vidas
      user.lives = 5;
    }
    user.livesDate = todayDate;
  } else if(user.livesDate !== todayDate) {
    user.lives = 5; // novo dia → restaura vidas, só uma vez
    user.livesDate = todayDate;
  }
  // Se livesDate === todayDate, NÃO restaura vidas, mesmo com logout/login, refresh ou troca de navegador.

  await saveUser(user);
  state.currentUser = user;
  // Recarrega módulos do Supabase ao fazer login para garantir que o usuário veja as últimas alterações do admin
  try {
    const _timeout = new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), 3000));
    const _fetch = getDB().from('app_config').select('value').eq('key', 'modules').single();
    const { data: cfgRow } = await Promise.race([_fetch, _timeout]);
    if(cfgRow && cfgRow.value) {
      let remoteModules = null;
      try { remoteModules = JSON.parse(cfgRow.value); } catch(pe) {}
      if(Array.isArray(remoteModules) && remoteModules.length > 0) {
        state.modules = remoteModules;
        localStorage.setItem('sa_modules', JSON.stringify(remoteModules));
      }
    }
  } catch(e) {
    // fallback: usa localStorage (tabela ainda não existe ou timeout)
    try {
      const _raw = localStorage.getItem('sa_modules');
      const _parsed = _raw ? JSON.parse(_raw) : null;
      if (Array.isArray(_parsed) && _parsed.length > 0) state.modules = _parsed;
    } catch(e2) {
      console.warn('sa_modules corrompido no localStorage (login), limpando...');
      localStorage.removeItem('sa_modules');
    }
  }
  if (!Array.isArray(state.modules)) state.modules = [];
  ensureHSEFirst();

  // Carrega o módulo HSE do Supabase/localStorage para garantir que edições do admin sejam vistas
  await loadHSEModuleFromSupabase();

  // Recalculate derived counters (not stored in DB) from completedLessons + modules
  const _allLessons = state.modules.flatMap(m => m.lessons || []);
  const _doneLessonIds = new Set(user.completedLessons || []);
  user.questionsAnswered = _allLessons.filter(l => _doneLessonIds.has(l.id)).reduce((acc, l) => acc + (l.questions ? l.questions.length : 0), 0);
  user.completedModules  = state.modules.filter(m => (m.lessons||[]).length > 0 && (m.lessons||[]).every(l => _doneLessonIds.has(l.id))).length;

  hideLoading();

  // Existing users without position must update before continuing
  if(!user.position) {
    showProfileUpdateModal(user);
    return;
  }

  showScreen('screen-welcome');
  updateNavStats();

  if(user.isAdmin) {
    document.getElementById('nav-admin').classList.remove('hidden');
    document.getElementById('nav-crm').classList.remove('hidden');
    document.getElementById('nav-users').classList.remove('hidden');
    document.getElementById('nav-monitoring').classList.remove('hidden');
    document.getElementById('nav-report').classList.remove('hidden');
  }

  // HSE agora é o primeiro módulo da trilha normal para TODOS os cargos (inclusive Líder).
  // O fluxo especial de tela de Líder foi descontinuado em favor da progressão sequencial unificada.

  setTimeout(function() {
    showScreen('screen-main');
    renderHome();
    switchPage('home');
  }, 5000);

  renderHome();
}

