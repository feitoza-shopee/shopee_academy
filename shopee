      <p style="font-size:12px;color:var(--text2);margin-top:6px;font-weight:600;">${completedCount} de ${totalLessons} lições concluídas</p>
    </div>
    <div class="section-title">📚 Módulos de Aprendizado</div>
  `;

  // Append no-lives banner after template if lives = 0
  if(u.lives === 0) {
    html += '<div style="background:linear-gradient(135deg,#E74C3C,#C0392B);border-radius:16px;padding:18px 20px;margin-bottom:16px;color:#fff;display:flex;align-items:center;gap:14px;box-shadow:0 4px 16px rgba(231,76,60,0.35)">' +
      '<div style="font-size:40px;flex-shrink:0">💔</div>' +
      '<div>' +
        '<div style="font-weight:900;font-size:15px;margin-bottom:2px">Sem vidas hoje!</div>' +
        '<div style="font-size:12px;opacity:0.9;font-weight:600">Volte amanhã — suas vidas serão renovadas automaticamente. Explore o ranking e seu perfil!</div>' +
      '</div></div>';
  }

  state.modules.forEach((mod, mi) => {
    const lessonsDone = mod.lessons.filter(l => (u.completedLessons||[]).includes(l.id)).length;
    const total = mod.lessons.length;
    const pct = total ? Math.round(lessonsDone/total*100) : 0;
    const isLocked = !state.currentUser.isAdmin && mi > 0 && !state.modules[mi-1].lessons.every(l => (u.completedLessons||[]).includes(l.id));
    const isDone = pct===100;

    html += `
      <div class="module-card${isLocked?' locked':''}" onclick="${isLocked?'showLockedMsg()':'openModule(\''+mod.id+'\')'}">
        ${isDone?'<div class="badge-complete">✓ Concluído</div>':''}
        ${isLocked?'<div class="badge-locked">🔒</div>':''}
        <div class="module-header">
          <div class="module-icon" style="background:${mod.color}">${mod.icon}</div>
          <div>
            <h3>${mod.title}</h3>
            <p class="module-desc">${mod.description}</p>
          </div>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;font-weight:700;color:var(--text2);margin-bottom:6px;">
          <span>${lessonsDone}/${total} lições</span>
          <span style="color:var(--shopee)">${pct}%</span>
        </div>
        <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:${pct}%"></div></div>
      </div>
    `;
  });

  document.getElementById('page-home').innerHTML = html;
}

function showLockedMsg() {
  alert('🔒 Complete o módulo anterior para desbloquear este!');
}

function openModule(modId) {
  const mod = state.modules.find(m => m.id===modId);
  if(!mod) return;
  const u = state.currentUser;

  // Trava de segurança: impede abrir módulo fora de sequência mesmo via chamada direta (console/URL)
  if(!u.isAdmin) {
    const mi = state.modules.indexOf(mod);
    if(mi > 0) {
      const prevMod = state.modules[mi-1];
      const prevDone = prevMod.lessons.every(l => (u.completedLessons||[]).includes(l.id));
      if(!prevDone) { showLockedMsg(); return; }
    }
  }

  state.currentModule = mod;

  let html = `
    <button class="back-btn" onclick="backToHome()">← Voltar</button>
    <div style="background:${mod.color};border-radius:16px;padding:20px;color:#fff;margin-bottom:20px;box-shadow:var(--shadow)">
      <div style="font-size:36px;margin-bottom:8px">${mod.icon}</div>
      <h2 style="font-size:20px;font-weight:900;margin-bottom:4px">${mod.title}</h2>
      <p style="font-size:13px;opacity:0.9;font-weight:600">${mod.description}</p>
    </div>
    <div class="section-title">📖 Lições</div>
  `;

  mod.lessons.forEach((lesson, li) => {
    const done = (u.completedLessons||[]).includes(lesson.id);
    const isLocked = !state.currentUser.isAdmin && li > 0 && !(u.completedLessons||[]).includes(mod.lessons[li-1].id);
    const noLives = !hasLives();
    const blocked = !done && !isLocked && noLives;
    const inProgress = !done && !isLocked && !blocked &&
      !!localStorage.getItem('sa_qprog_' + u.id + '_' + lesson.id);

    // Progresso parcial: questões já acertadas (persistido em localStorage)
    const correctIdx = done ? null : getCorrectQuestionIndices(lesson.id);
    const correctCount = correctIdx ? correctIdx.length : 0;
    const totalQ = lesson.questions.length;

    let clickFn = '';
    if(done) clickFn = 'showLessonDoneMsg()';
    else if(isLocked) clickFn = '';
    else if(blocked) clickFn = 'showNoLivesModal()';
    else clickFn = 'startLesson(\''+mod.id+'\',\''+lesson.id+'\')';

    let progressBadge = '';
    if(!done && correctCount > 0) {
      progressBadge = `<span style="color:var(--shopee);font-weight:800;font-size:11px;margin-left:4px;">✅ ${correctCount}/${totalQ} acertadas${inProgress?' · ▶ Continuar':''}</span>`;
    } else if(inProgress) {
      progressBadge = '<span style="color:var(--shopee);font-weight:800;font-size:11px;margin-left:4px;">▶ Continuar</span>';
    }

    const pendingCount = done ? 0 : totalQ - correctCount;
    const xpLabel = done
      ? '<span style="color:var(--green);font-size:11px;font-weight:800;">Concluída</span>'
      : correctCount > 0
        ? `<span style="font-size:11px;font-weight:800;color:var(--shopee);">${pendingCount} restante${pendingCount!==1?'s':''}</span>`
        : '+'+lesson.xpReward+' XP';

    html += `
      <div class="lesson-card${(isLocked||blocked)?' locked':''}" onclick="${clickFn}">
        <div class="lesson-num${done?' done':(isLocked||blocked)?' locked-icon':''}">
          ${done?'✓':(isLocked||blocked)?'🔒':correctCount > 0 ? '▶' : (li+1)}
        </div>
        <div class="lesson-info">
          <h4>${lesson.title}</h4>
          <p>${lesson.description} · ${totalQ} questões${done?' · <span style="color:var(--green);font-weight:800;">✅ Concluída</span>':''}${progressBadge}</p>
        </div>
        <div class="lesson-xp">${xpLabel}</div>
      </div>
    `;
  });

  document.getElementById('page-lessons').innerHTML = html;
  switchPage('lessons');
}

function backToHome() {
  switchPage('home');
}

