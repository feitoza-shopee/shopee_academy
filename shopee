// ── Module CRUD ────────────────────────────────────────────────
function moveModule(modId, direction) {
  const idx = state.modules.findIndex(m => m.id === modId);
  if(idx === -1) return;
  // mod_prova (1º), mod_hse (2º) e mod_hse_lider (3º) são fixos — não podem ser movidos
  if(modId === 'mod_prova' || modId === 'mod_hse' || modId === 'mod_hse_lider') return;
  const newIdx = idx + direction;
  // Posições 0, 1 e 2 são reservadas a mod_prova, HSE e HSE Líderes
  const fixedCount = state.modules.filter(m => m.id === 'mod_prova' || m.id === 'mod_hse' || m.id === 'mod_hse_lider').length;
  if(newIdx < fixedCount || newIdx >= state.modules.length) return;

  // Swap
  const temp = state.modules[idx];
  state.modules[idx] = state.modules[newIdx];
  state.modules[newIdx] = temp;

  saveModules();
  renderHome();
  document.getElementById('adm-modules-list').innerHTML = renderAdminModulesList();
  showToast('📋 Ordem dos módulos atualizada!');
}

function adminCreateModule() {
