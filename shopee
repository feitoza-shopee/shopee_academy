// ── Rastreamento de questões acertadas por lição ─────────────
// Persiste array de índices originais acertados em localStorage
// Chave: sa_cq_<userId>_<lessonId>  →  [0, 2, 5, ...]

function _cqKey(lessonId) {
  return 'sa_cq_' + (state.currentUser ? state.currentUser.id : 'x') + '_' + lessonId;
}

function getCorrectQuestionIndices(lessonId) {
  try {
    const raw = localStorage.getItem(_cqKey(lessonId));
    if(!raw) return [];
    const parsed = JSON.parse(raw);
    return Array.isArray(parsed) ? parsed : [];
  } catch(e) { return []; }
}

function saveCorrectQuestionIndices(lessonId, indicesArray) {
  try {
    localStorage.setItem(_cqKey(lessonId), JSON.stringify(indicesArray));
  } catch(e) {}
}

function clearCorrectQuestionIndices(lessonId) {
  try { localStorage.removeItem(_cqKey(lessonId)); } catch(e) {}
}

function _quizProgressKey(lessonId) {
  return 'sa_qprog_' + (state.currentUser ? state.currentUser.id : 'x') + '_' + lessonId;
}
function saveQuizProgress() {
  const q = state.quiz;
  if(!q || !state.currentLesson) return;
  const key = _quizProgressKey(state.currentLesson.id);
  const progress = {
    lessonId: state.currentLesson.id,
    current: q.current,
    lives: q.lives,
    errors: q.errors,
    correct: q.correct,
    answered: q.answered,
    selectedAnswer: q.selectedAnswer
  };
  localStorage.setItem(key, JSON.stringify(progress));

  // Persiste os índices de questões acertadas (array simples)
  if(q.correctIndices && Array.isArray(q.correctIndices)) {
    saveCorrectQuestionIndices(state.currentLesson.id, q.correctIndices);
  }

  // Persiste no Supabase a cada resposta, garantindo continuidade entre dispositivos
  const u = state.currentUser;
  if(u && !u.isAdmin) {
    u.quizProgress = progress;
    u.lives = q.lives;
    saveUser(u).catch(e => console.warn('saveQuizProgress remoto falhou:', e));
  }
}
function clearQuizProgress(lessonId) {
  localStorage.removeItem(_quizProgressKey(lessonId));
}

function startLesson(modId, lessonId) {
  if(!hasLives()) { showNoLivesModal(); return; }
  const mod = state.modules.find(m => m.id===modId);
  const lesson = mod.lessons.find(l => l.id===lessonId);
  const u = state.currentUser;

  // Trava de segurança: módulo deve estar desbloqueado e lição deve seguir a ordem
  if(!u.isAdmin) {
    const mi = state.modules.indexOf(mod);
    if(mi > 0) {
      const prevMod = state.modules[mi-1];
      if(!prevMod.lessons.every(l => (u.completedLessons||[]).includes(l.id))) { showLockedMsg(); return; }
    }
    const li = mod.lessons.indexOf(lesson);
    if(li > 0 && !(u.completedLessons||[]).includes(mod.lessons[li-1].id)) { showLockedMsg(); return; }
  }

  state.currentModule = mod;
  state.currentLesson = lesson;

  _launchQuiz(lesson, u);
}

/**
 * _launchQuiz — ponto central de inicialização do quiz.
 * Filtra questões já acertadas, monta state.quiz e abre a tela.
 * Usado por startLesson, startLeaderLesson e startLeaderRegularLesson.
 */
function _launchQuiz(lesson, u) {
  const lessonId = lesson.id;

  // Índices (na lista original da lição) que o usuário já acertou em sessões anteriores
  const alreadyCorrect = getCorrectQuestionIndices(lessonId); // array de números

  // Monta lista de questões pendentes mantendo referência ao índice original
  const pending = [];
  lesson.questions.forEach(function(q, origIdx) {
    if(alreadyCorrect.indexOf(origIdx) === -1) {
      // Cria cópia rasa com índice original embutido
      const copy = Object.assign({}, q, { _origIdx: origIdx });
      pending.push(copy);
    }
  });

  // Caso especial: todas já acertadas mas lição não marcada como concluída
  // (pode acontecer se o save falhou na sessão anterior)
  if(pending.length === 0) {
    // Força conclusão
    if(!(u.completedLessons||[]).includes(lessonId)) {
      if(!u.completedLessons) u.completedLessons = [];
      u.completedLessons.push(lessonId);
      clearCorrectQuestionIndices(lessonId);
      saveUser(u);
      updateNavStats();
    }
    showToast('✅ Lição já concluída! Todas as questões foram acertadas.');
    return;
  }

  // Recupera progresso salvo da sessão interrompida (cursor dentro das pendentes)
  let savedProgress = null;
  if(u.quizProgress && u.quizProgress.lessonId === lessonId) {
    savedProgress = u.quizProgress;
  } else {
    try {
      const raw = localStorage.getItem(_quizProgressKey(lessonId));
      savedProgress = raw ? JSON.parse(raw) : null;
    } catch(e) {}
  }

  // Garante que o cursor salvo é válido para a lista filtrada atual
  const savedCurrent = savedProgress && typeof savedProgress.current === 'number'
    ? savedProgress.current : 0;
  const safeCurrent = (savedCurrent >= 0 && savedCurrent < pending.length) ? savedCurrent : 0;

  state.quiz = {
    questions:      pending,
    totalQuestions: lesson.questions.length,  // total original
    correctIndices: alreadyCorrect.slice(),   // cópia do array — acumula ao longo da sessão
    current:        safeCurrent,
    lives:          (u.lives !== undefined && u.lives !== null) ? u.lives : 5,
    errors:         savedProgress ? (savedProgress.errors || 0) : 0,
    correct:        savedProgress ? (savedProgress.correct || 0) : 0,
    startTime:      Date.now(),
    selectedAnswer: null,
    answered:       false
  };

  showScreen('screen-quiz');
  renderQuestion();
}

function renderQuestion() {
  const q = state.quiz;
  const question = q.questions[q.current];
  trackQuestionAttempt(question, state.currentLesson, state.currentModule);

  // Progresso global = (já acertadas antes + posição atual nas pendentes) / total original
  const alreadyCorrect = q.correctIndices ? q.correctIndices.length : 0;
  const totalOrig = q.totalQuestions || q.questions.length;
  const globalProgress = Math.min(((alreadyCorrect + q.current) / totalOrig) * 100, 100);
  document.getElementById('quiz-progress-fill').style.width = globalProgress + '%';

  // Contador: mostra questões restantes e já acertadas
  const counterEl = document.getElementById('quiz-question-counter');
  if(counterEl) {
    const pendingTotal = q.questions.length;
    if(alreadyCorrect > 0) {
      counterEl.textContent = (q.current + 1) + '/' + pendingTotal + ' restantes · ✅ ' + alreadyCorrect + '/' + totalOrig + ' acertadas';
    } else {
      counterEl.textContent = (q.current + 1) + ' / ' + totalOrig;
    }
  }

  // Vidas
  let livesHtml = '';
  for(let i=0;i<5;i++) {
    livesHtml += '<span class="heart">' + (i < q.lives ? '❤️' : '🖤') + '</span>';
  }
  document.getElementById('quiz-lives-display').innerHTML = livesHtml;

  // Reset footer
  const footer = document.getElementById('quiz-footer');
  footer.className = 'quiz-footer';
  footer.innerHTML = '<button class="btn-check primary-action" id="btn-check" onclick="checkAnswer()" disabled>Verificar</button>';

  q.selectedAnswer = null;
  q.answered = false;

  // Render question
  let html = '';

  if(question.type==='multiple') {
    html += `
      <div class="question-type-badge">Múltipla Escolha</div>
      <div class="question-text">${question.q}</div>
      <div class="choices-grid">
    `;
    const letters = ['A','B','C','D','E'];
    question.options.forEach((opt, i) => {
      html += `
        <button class="choice-btn" id="choice-${i}" onclick="selectChoice(${i})">
          <span class="choice-letter">${letters[i]}</span>
          ${opt}
        </button>
      `;
    });
    html += '</div>';

  } else if(question.type==='truefalse') {
    html += `
      <div class="question-type-badge">Verdadeiro ou Falso</div>
      <div class="question-text">${question.q}</div>
      <div class="tf-grid">
        <button class="tf-btn" id="tf-true" onclick="selectTF(true)">
          <span class="tf-icon">✅</span>VERDADEIRO
        </button>
        <button class="tf-btn" id="tf-false" onclick="selectTF(false)">
          <span class="tf-icon">❌</span>FALSO
        </button>
      </div>
    `;

  } else if(question.type==='order') {
    // Shuffle steps for display
    const shuffled = [...question.steps].map((s,i)=>({text:s, origIdx:i}));
    for(let i=shuffled.length-1;i>0;i--){
      const j=Math.floor(Math.random()*(i+1));
      [shuffled[i],shuffled[j]]=[shuffled[j],shuffled[i]];
    }
    q.shuffledOrder = shuffled;

    html += `
      <div class="question-type-badge">Ordenar Etapas</div>
      <div class="question-text">${question.q}</div>
      <div class="order-instruction">⬆️ Arraste ou use as setas para ordenar corretamente</div>
      <div class="order-items" id="order-items">
    `;
    shuffled.forEach((item, i) => {
      html += `
        <div class="order-item" draggable="true" data-idx="${i}" 
             ondragstart="dragStart(event)" ondragover="dragOver(event)" ondrop="dropItem(event)">
          <span class="drag-handle">⋮⋮</span>
          <span class="order-num">${i+1}</span>
          <span style="flex:1">${item.text}</span>
          <div style="display:flex;flex-direction:column;gap:2px">
            <button onclick="moveOrderItem(${i},-1)" style="background:none;border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px;padding:2px 6px">▲</button>
            <button onclick="moveOrderItem(${i},1)" style="background:none;border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px;padding:2px 6px">▼</button>
          </div>
        </div>
      `;
    });
    html += '</div>';

    // Order questions: enable check immediately
    setTimeout(() => {
      const btn = document.getElementById('btn-check');
      if(btn) { btn.disabled=false; }
    }, 100);
  }

  document.getElementById('quiz-body').innerHTML = html;
}

// Multiple choice
function selectChoice(idx) {
  if(state.quiz.answered) return;
  document.querySelectorAll('.choice-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById('choice-'+idx).classList.add('selected');
  state.quiz.selectedAnswer = idx;
  document.getElementById('btn-check').disabled = false;
}

// True/False
function selectTF(val) {
  if(state.quiz.answered) return;
  document.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('selected'));
  document.getElementById(val ? 'tf-true' : 'tf-false').classList.add('selected');
  state.quiz.selectedAnswer = val;
  document.getElementById('btn-check').disabled = false;
}

// Drag & Drop for Order
let dragSrcIdx = null;
function dragStart(e) {
  dragSrcIdx = parseInt(e.currentTarget.dataset.idx);
}
function dragOver(e) { e.preventDefault(); }
function dropItem(e) {
  const targetIdx = parseInt(e.currentTarget.closest('.order-item').dataset.idx);
  if(dragSrcIdx === null || dragSrcIdx === targetIdx) return;
  const arr = state.quiz.shuffledOrder;
  const tmp = arr[dragSrcIdx];
  arr[dragSrcIdx] = arr[targetIdx];
  arr[targetIdx] = tmp;
  renderOrderItems();
}
function moveOrderItem(idx, dir) {
  const arr = state.quiz.shuffledOrder;
  const newIdx = idx + dir;
  if(newIdx < 0 || newIdx >= arr.length) return;
  const tmp = arr[idx];
  arr[idx] = arr[newIdx];
  arr[newIdx] = tmp;
  renderOrderItems();
}
function renderOrderItems() {
  const container = document.getElementById('order-items');
  if(!container) return;
  const arr = state.quiz.shuffledOrder;
  container.innerHTML = arr.map((item,i) => `
    <div class="order-item" draggable="true" data-idx="${i}"
         ondragstart="dragStart(event)" ondragover="dragOver(event)" ondrop="dropItem(event)">
      <span class="drag-handle">⋮⋮</span>
      <span class="order-num">${i+1}</span>
      <span style="flex:1">${item.text}</span>
      <div style="display:flex;flex-direction:column;gap:2px">
        <button onclick="moveOrderItem(${i},-1)" style="background:none;border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px;padding:2px 6px">▲</button>
        <button onclick="moveOrderItem(${i},1)" style="background:none;border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px;padding:2px 6px">▼</button>
      </div>
    </div>
  `).join('');
}

// ============================================================
// CHECK ANSWER
// ============================================================
// Verifica se a lição/quiz atual pertence ao módulo Prova. O módulo Prova
// tem regras especiais: errar não revela a resposta certa, não avança para
// a próxima pergunta e não marca pontos — o jogador precisa tentar de novo
// até acertar para então avançar e pontuar.
function isProvaModule() {
  return !!(state.currentModule && state.currentModule.id === 'mod_prova');
}

function checkAnswer() {
  const q = state.quiz;
  const question = q.questions[q.current];
  q.answered = true;

  const isProva = isProvaModule();
  let isCorrect = false;

  if(question.type==='multiple') {
    isCorrect = q.selectedAnswer === question.answer;
    document.querySelectorAll('.choice-btn').forEach((b,i) => {
      b.disabled = true;
      // No módulo Prova, se errou, não revela qual era a opção correta.
      if(isCorrect || !isProva) {
        if(i === question.answer) b.classList.add('correct');
      }
      if(i === q.selectedAnswer && !isCorrect) b.classList.add('wrong');
    });

  } else if(question.type==='truefalse') {
    isCorrect = q.selectedAnswer === question.answer;
    document.querySelectorAll('.tf-btn').forEach(b => b.disabled=true);
    if(isCorrect || !isProva) {
      if(question.answer) document.getElementById('tf-true').classList.add('correct');
      else document.getElementById('tf-false').classList.add('correct');
    }
    if(!isCorrect) {
      if(q.selectedAnswer) document.getElementById('tf-true').classList.add('wrong');
      else document.getElementById('tf-false').classList.add('wrong');
    }

  } else if(question.type==='order') {
    // Compare shuffled order's origIdx sequence with correctOrder
    const userOrder = q.shuffledOrder.map(i=>i.origIdx);
    const correctSeq = question.correctOrder;
    isCorrect = JSON.stringify(userOrder) === JSON.stringify(correctSeq);
    // Highlight items — no módulo Prova, se errou, não revela as posições certas/erradas
    // em detalhe, apenas sinaliza que a ordem está incorreta.
    document.querySelectorAll('.order-item').forEach((el,i) => {
      if(isCorrect || !isProva) {
        if(userOrder[i] === correctSeq[i]) el.classList.add('correct-pos');
        else el.classList.add('wrong-pos');
      } else {
        el.classList.add('wrong-pos');
      }
    });
  }

  if(isCorrect) {
    q.correct++;
    // Registra o índice original da questão no array de acertos
    if(Array.isArray(q.correctIndices) && typeof question._origIdx === 'number') {
      if(q.correctIndices.indexOf(question._origIdx) === -1) {
        q.correctIndices.push(question._origIdx);
      }
    }
    showFeedback(true, question.explanation);
  } else {
    q.errors++;
    q.lives--;
    trackQuestionError(question, state.currentLesson, state.currentModule);
    // Registra a questão errada no relatório individual do colaborador
    if(state.currentUser && !state.currentUser.isAdmin) {
      saveUserWrongAnswer(state.currentUser.id, {
        date: today(),
        modId: state.currentModule ? state.currentModule.id : '',
        modTitle: state.currentModule ? state.currentModule.title : '',
        lessonId: state.currentLesson ? state.currentLesson.id : '',
        lessonTitle: state.currentLesson ? state.currentLesson.title : '',
        question: question.q,
        userAnswer: _answerLabelForQuestion(question, q.selectedAnswer, q),
        correctAnswer: _correctAnswerLabelForQuestion(question)
      });
    }
    // No módulo Prova: não mostra a explicação/resposta certa, apenas pede para tentar de novo.
    showFeedback(false, isProva ? '' : question.explanation);
  }
  // Persiste imediatamente após cada resposta (certa ou errada) — garante continuidade
  // entre dispositivos mesmo se o usuário fechar a aba antes de avançar.
  saveQuizProgress();
}

// Texto legível da resposta dada pelo usuário (para o relatório individual)
function _answerLabelForQuestion(question, val, qState) {
  if(question.type === 'multiple') {
    return (typeof val === 'number' && question.options && question.options[val] !== undefined) ? question.options[val] : '—';
  }
  if(question.type === 'truefalse') {
    return val === true ? 'Verdadeiro' : (val === false ? 'Falso' : '—');
  }
  if(question.type === 'order') {
    if(qState && Array.isArray(qState.shuffledOrder)) {
      return qState.shuffledOrder.map(it => it.text).join(' → ');
    }
    return '—';
  }
  return '—';
}

// Texto legível da resposta correta (para o relatório individual)
function _correctAnswerLabelForQuestion(question) {
  if(question.type === 'multiple') {
    return (question.options && question.options[question.answer] !== undefined) ? question.options[question.answer] : '—';
  }
  if(question.type === 'truefalse') {
    return question.answer ? 'Verdadeiro' : 'Falso';
  }
  if(question.type === 'order') {
    if(Array.isArray(question.correctOrder) && Array.isArray(question.steps)) {
      return question.correctOrder.map(i => question.steps[i]).join(' → ');
    }
    return '—';
  }
  return '—';
}

