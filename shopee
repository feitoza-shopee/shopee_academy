        ${searchQuery ? `<button onclick="clearUsersSearch()" style="padding:10px 14px;background:var(--bg);border:2px solid var(--border);border-radius:10px;font-family:Nunito,sans-serif;font-size:13px;font-weight:800;cursor:pointer;color:var(--text2);">✕</button>` : ''}
      </div>
    </div>

    <!-- FILTERS (selects continuam aplicando na hora, pois não são campos de digitação livre) -->
    <div style="background:#fff;border-radius:16px;padding:16px;margin-bottom:14px;border:2px solid var(--border);box-shadow:var(--shadow);">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
