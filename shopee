// Handle drag-and-drop
function handlePDFDrop(event) {
  const files = Array.from(event.dataTransfer.files).filter(f => f.type === 'application/pdf' || f.name.endsWith('.pdf'));
  if(files.length === 0) { showToast('⚠️ Apenas arquivos PDF são aceitos.'); return; }
  processPDFFiles(files);
}

async function handlePDFUpload(event) {
  const files = Array.from(event.target.files);
  if(!files.length) return;
  processPDFFiles(files);
  // Reset input so same files can be re-selected if needed
  event.target.value = '';
}

async function processPDFFiles(files) {
  // Show selected files list
  const fileListEl = document.getElementById('pdf-file-list');
  const statusEl = document.getElementById('pdf-status');
  const genEl = document.getElementById('generated-qs');
  const btnAdd = document.getElementById('btn-add-module');

  genEl.classList.add('hidden');
  btnAdd.classList.add('hidden');
  state.generatedQuestions = [];
  state._pendingPDFFiles = files;

  fileListEl.innerHTML = '<div style="font-weight:800;font-size:13px;margin-bottom:8px;color:var(--text);">📎 Arquivos selecionados:</div>' +
    files.map((f,i) => `<div style="display:flex;align-items:center;gap:8px;background:var(--bg);border-radius:8px;padding:8px 10px;margin-bottom:6px;border:1.5px solid var(--border);">
      <span style="font-size:16px;">📄</span>
      <div style="flex:1;">
        <div style="font-size:12px;font-weight:800;">${f.name}</div>
        <div style="font-size:10px;color:var(--text2);">${(f.size/1024).toFixed(1)} KB</div>
      </div>
      <div id="pdf-status-${i}" style="font-size:11px;font-weight:700;color:var(--text2);">⏳ Aguardando</div>
    </div>`).join('');

  statusEl.innerHTML = '';

  // Process all files — for multi-file, process each and accumulate questions
  if(files.length === 1) {
    // Single file: original flow
    state._pendingPDFFile = files[0];
    const reader = new FileReader();
    reader.onload = async function(e) {
      const base64 = e.target.result.split(',')[1];
      document.getElementById('pdf-status-0').textContent = '🔄 Processando...';
      document.getElementById('pdf-status-0').style.color = 'var(--blue)';
      await generateQuestionsFromPDF(base64, files[0].name);
      document.getElementById('pdf-status-0').textContent = '✅ Pronto';
      document.getElementById('pdf-status-0').style.color = 'var(--green)';
    };
    reader.readAsDataURL(files[0]);
  } else {
    // Multiple files: process sequentially, accumulate all questions
    let allQuestions = [];
    const apiKey = getAPIKey();
    if(!apiKey) {
      statusEl.innerHTML = '<div class="error-msg">❌ API Key não configurada. Vá em Admin > Configuração da API Key.</div>';
      return;
    }
    statusEl.innerHTML = `<div class="generating-indicator"><div class="spinner"></div><div><div style="font-weight:800;font-size:14px">🤖 Processando ${files.length} PDFs...</div><div style="font-size:12px;color:var(--text2)">Aguarde enquanto a IA analisa cada arquivo</div></div></div>`;

    for(let i = 0; i < files.length; i++) {
      const file = files[i];
      const statusBadge = document.getElementById('pdf-status-' + i);
      if(statusBadge) { statusBadge.textContent = '🔄 Processando...'; statusBadge.style.color = 'var(--blue)'; }
      try {
        const base64 = await new Promise((res, rej) => {
          const r = new FileReader();
          r.onload = e => res(e.target.result.split(',')[1]);
          r.onerror = rej;
          r.readAsDataURL(file);
        });
        const qs = await generateQuestionsFromPDFRaw(base64, file.name, apiKey);
        allQuestions = allQuestions.concat(qs);
        if(statusBadge) { statusBadge.textContent = `✅ ${qs.length} questões`; statusBadge.style.color = 'var(--green)'; }
        // Register each PDF
        registerPDFInLibrary(file, file.name.replace(/\.pdf$/i,''));
      } catch(err) {
        if(statusBadge) { statusBadge.textContent = '❌ Erro'; statusBadge.style.color = 'var(--shopee)'; }
        console.error('Error processing', file.name, err);
      }
    }

    state.generatedQuestions = allQuestions;
    state._pendingPDFFile = null;
    state._pendingPDFFiles = null;

    statusEl.innerHTML = '';
    if(allQuestions.length === 0) {
      statusEl.innerHTML = '<div class="error-msg">❌ Nenhuma questão foi gerada. Verifique os PDFs e a API Key.</div>';
      return;
    }

    genEl.classList.remove('hidden');
    genEl.innerHTML = `
      <div style="font-weight:900;font-size:14px;margin-bottom:8px;color:var(--green)">✅ ${allQuestions.length} questões geradas de ${files.length} PDFs!</div>
      ${allQuestions.map((q,i)=>`
        <div class="gen-q-item">
          <div class="q-type-tag">${q.type==='multiple'?'Múltipla Escolha':q.type==='truefalse'?'V ou F':'Ordenar'}</div>
          ${q.q}
        </div>
      `).join('')}
    `;
    btnAdd.classList.remove('hidden');
  }
}

// Raw version — returns questions array (no UI updates), used for multi-file processing
async function generateQuestionsFromPDFRaw(base64Data, filename, apiKey) {
  const response = await fetch('https://api.anthropic.com/v1/messages', {
    method:'POST',
    headers:{
      'Content-Type':'application/json',
      'x-api-key': apiKey,
      'anthropic-version': '2023-06-01',
      'anthropic-dangerous-direct-browser-access': 'true'
    },
    body: JSON.stringify({
      model:'claude-sonnet-4-20250514',
      max_tokens:3000,
      messages:[{
        role:'user',
        content:[
          {
            type:'document',
            source:{ type:'base64', media_type:'application/pdf', data:base64Data }
          },
          {
            type:'text',
            text:`Analise este documento sobre processos da Shopee e gere exatamente 8 questões educativas em JSON.

Retorne SOMENTE um array JSON válido, sem texto extra, sem markdown, sem \`\`\`. Siga este formato:
[
  {
    "type": "multiple",
    "q": "Pergunta de múltipla escolha?",
    "options": ["Opção A", "Opção B", "Opção C", "Opção D"],
    "answer": 1,
    "explanation": "Explicação curta do porquê está correto."
  },
  {
    "type": "truefalse",
    "q": "Afirmação verdadeira ou falsa.",
    "answer": true,
    "explanation": "Explicação curta."
  },
  {
    "type": "order",
    "q": "Ordene as etapas do processo:",
    "steps": ["Passo A", "Passo B", "Passo C", "Passo D"],
    "correctOrder": [0, 1, 2, 3],
    "explanation": "Explicação da ordem correta."
  }
]

Gere uma mistura: pelo menos 4 multiple choice, 2 verdadeiro/falso, 2 order. Todas as perguntas devem ser baseadas no conteúdo real do documento.`
          }
        ]
      }]
    })
  });

  if(!response.ok) {
    let errMsg = response.statusText;
    try { const e = await response.json(); errMsg = e?.error?.message || errMsg; } catch(x){}
    throw new Error('Erro da API (' + response.status + '): ' + errMsg);
  }

  const data = await response.json();
  const rawText = data.content?.find(c=>c.type==='text')?.text || '';
  if(!rawText) throw new Error('A IA não retornou conteúdo.');

  let questions;
  try { questions = JSON.parse(rawText.trim()); }
  catch(e1) {
    try { const match = rawText.match(/\[[\s\S]*\]/); if(match) questions = JSON.parse(match[0]); else throw new Error('no array'); }
    catch(e2) {
      try { const clean = rawText.replace(/```json|```/g,'').trim(); questions = JSON.parse(clean); }
      catch(e3) { throw new Error('Erro ao interpretar resposta da IA.'); }
    }
  }
  if(!Array.isArray(questions) || questions.length === 0) throw new Error('Nenhuma questão válida gerada.');
  return questions;
}

