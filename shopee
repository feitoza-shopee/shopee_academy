        <h3>${u.streak} dia${u.streak!==1?'s':''} em sequência!</h3>
        <p>Continue assim para subir no ranking!</p>
      </div>
    </div>
    <div style="background:#fff;border:2px solid var(--border);border-radius:16px;padding:16px 20px;margin-bottom:20px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <span style="font-weight:800;font-size:14px;">Progresso Geral</span>
        <span style="font-weight:900;color:var(--shopee);">${percent}%</span>
      </div>
