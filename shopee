function updateLeaderNavStats() {
  const u = state.currentUser; if(!u) return;
  const s = document.getElementById('leader-nav-streak');
  const x = document.getElementById('leader-nav-xp');
  const l = document.getElementById('leader-nav-lives');
  if(s) s.textContent = u.streak || 0;
  if(x) x.textContent = (u.xp || 0).toLocaleString();
  if(l) l.textContent = (u.lives !== undefined && u.lives !== null) ? u.lives : 5;
}

function renderLeaderHome() {
  if (!Array.isArray(state.modules)) state.modules = [];
  const u   = state.currentUser;
  const el  = document.getElementById('page-leader-home');
  if(!el) return;
  updateLeaderNavStats();
  const mod = HSE_MODULE;
  const totalL = mod.lessons.length;
  const doneL  = mod.lessons.filter(l => (u.completedLessons||[]).includes(l.id)).length;
  const pct    = totalL ? Math.round(doneL/totalL*100) : 0;

  const noLives = hasLives() === false;

  let lessonsHtml = mod.lessons.map((les, idx) => {
    const done   = (u.completedLessons||[]).includes(les.id);
    const locked = idx > 0 && !(u.completedLessons||[]).includes(mod.lessons[idx-1].id);
    const blocked = !done && !locked && noLives;
    const inProgress = !done && !locked && !blocked && !!localStorage.getItem('sa_qprog_' + u.id + '_' + les.id);
    const numContent = done ? '✓' : (locked || blocked) ? '🔒' : (idx+1);
    const numClass   = done ? 'done' : (locked || blocked) ? 'locked-icon' : '';
    const clickFn    = done ? 'showLessonDoneMsg()' : locked ? 'showLockedMsg()' : blocked ? 'showNoLivesModal()' : 'startLeaderLesson('+idx+')';
    const xpLabel    = done ? '<span style="color:var(--green);font-size:11px;font-weight:800;">Concluída</span>' : '+' + les.xpReward + ' XP';
    const progressBadge = inProgress ? ' · <span style="color:var(--shopee);font-weight:800;font-size:11px;">▶ Continuar</span>' : '';
    return '<div class="lesson-card' + ((locked||blocked)?' locked':'') + '" onclick="' + clickFn + '">' +
      '<div class="lesson-num ' + numClass + '">' + numContent + '</div>' +
      '<div class="lesson-info"><h4>' + les.title + '</h4><p>' + les.description + (done?' · <span style="color:var(--green);font-weight:800;">✅ Concluída</span>':'') + progressBadge + '</p></div>' +
      '<div class="lesson-xp">' + xpLabel + '</div></div>';
  }).join('');

  let noLivesBanner = '';
  if(noLives) {
    noLivesBanner = '<div style="background:linear-gradient(135deg,#E74C3C,#C0392B);border-radius:16px;padding:18px 20px;margin-bottom:16px;color:#fff;display:flex;align-items:center;gap:14px;">' +
      '<div style="font-size:40px;flex-shrink:0">💔</div>' +
      '<div><div style="font-weight:900;font-size:15px;margin-bottom:2px">Sem vidas hoje!</div>' +
      '<div style="font-size:12px;opacity:0.9;font-weight:600">Volte amanhã — suas vidas serão renovadas automaticamente.</div></div></div>';
  }

  const hseAllDone = mod.lessons.length > 0 && mod.lessons.every(l => (u.completedLessons||[]).includes(l.id));

  // Build extra modules section if HSE is completed
  let extraModulesHtml = '';
  if(hseAllDone && state.modules && state.modules.length > 0) {
    const modCards = state.modules.map((rm, mi) => {
      const totalRl = rm.lessons.length;
      const doneRl  = rm.lessons.filter(l => (u.completedLessons||[]).includes(l.id)).length;
      const pctRl   = totalRl ? Math.round(doneRl/totalRl*100) : 0;
      const isModDone = totalRl > 0 && doneRl === totalRl;
      const lessonCards = rm.lessons.map((les, li) => {
        const lessDone   = (u.completedLessons||[]).includes(les.id);
        const lessLocked = li > 0 && !(u.completedLessons||[]).includes(rm.lessons[li-1].id);
        const lessBlocked = !lessDone && !lessLocked && noLives;
        const lessInProgress = !lessDone && !lessLocked && !lessBlocked && !!localStorage.getItem('sa_qprog_' + u.id + '_' + les.id);
        const numContent = lessDone ? '✓' : (lessLocked || lessBlocked) ? '🔒' : (li+1);
        const numClass   = lessDone ? 'done' : (lessLocked || lessBlocked) ? 'locked-icon' : '';
        const clickFn    = lessDone ? 'showLessonDoneMsg()' : lessLocked ? 'showLockedMsg()' : lessBlocked ? 'showNoLivesModal()' : 'startLeaderRegularLesson('+mi+','+li+')';
        const xpLabel2   = lessDone ? '<span style="color:var(--green);font-size:11px;font-weight:800;">Concluída</span>' : '+' + les.xpReward + ' XP';
        const progressBadge2 = lessInProgress ? ' · <span style="color:var(--shopee);font-weight:800;font-size:11px;">▶ Continuar</span>' : '';
        return '<div class="lesson-card' + ((lessLocked||lessBlocked)?' locked':'') + '" onclick="' + clickFn + '">' +
          '<div class="lesson-num ' + numClass + '">' + numContent + '</div>' +
          '<div class="lesson-info"><h4>' + les.title + '</h4><p>' + (les.description||'') + (lessDone?' · <span style="color:var(--green);font-weight:800;">✅ Concluída</span>':'') + progressBadge2 + '</p></div>' +
          '<div class="lesson-xp">' + xpLabel2 + '</div></div>';
      }).join('');
      return '<div class="module-card" style="margin-bottom:12px;">' +
        (isModDone ? '<span class="badge-complete">✓ Completo</span>' : '') +
        '<div class="module-header"><div class="module-icon" style="background:' + rm.color + '">' + rm.icon + '</div>' +
        '<div><h3>' + rm.title + '</h3><p class="module-desc">' + rm.description + '</p></div></div>' +
        '<div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text2);font-weight:700;margin-bottom:4px"><span>Progresso</span><span>' + pctRl + '%</span></div>' +
        '<div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:' + pctRl + '%"></div></div>' +
        '<div style="margin-top:12px;">' + lessonCards + '</div>' +
        '</div>';
    }).join('');
    extraModulesHtml =
      '<div style="background:linear-gradient(135deg,#27AE60,#2ECC71);border-radius:16px;padding:16px 20px;margin-top:20px;margin-bottom:16px;color:#fff;display:flex;align-items:center;gap:12px;">' +
        '<div style="font-size:32px">🎓</div>' +
        '<div><div style="font-weight:900;font-size:15px;">Módulo HSE Concluído!</div><div style="font-size:12px;opacity:0.9;">Você desbloqueou os módulos gerais abaixo.</div></div>' +
      '</div>' +
      '<div class="section-title" style="margin-top:4px;">📦 Módulos Gerais</div>' +
      modCards;
  }

  el.innerHTML =
    '<div class="greeting" style="margin-bottom:16px"><h2>👋 Olá, ' + (u.nickname||u.name.split(' ')[0]) + '!</h2><p>Interface exclusiva de Líderes — Módulo HSE</p></div>' +
    '<div class="streak-banner"><div class="streak-icon">🦺</div><div><h3>HSE — Segurança em Foco</h3><p>Complete as lições para se tornar um Líder referência em segurança!</p></div></div>' +
    noLivesBanner +
    '<div class="module-card" style="margin-bottom:8px;">' +
      '<div class="module-header"><div class="module-icon" style="background:' + mod.color + '">' + mod.icon + '</div>' +
      '<div><h3>' + mod.title + '</h3><p class="module-desc">' + mod.description + '</p></div></div>' +
      '<div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text2);font-weight:700;margin-bottom:4px"><span>Progresso</span><span>' + pct + '%</span></div>' +
      '<div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:' + pct + '%"></div></div></div>' +
    '<div class="section-title" style="margin-top:20px">📚 Lições HSE</div>' + lessonsHtml +
    extraModulesHtml +
    '<div class="stats-grid" style="margin-top:20px">' +
      '<div class="stat-card"><div class="sc-value">⭐ ' + (u.xp||0).toLocaleString() + '</div><div class="sc-label">XP Total</div></div>' +
      '<div class="stat-card"><div class="sc-value">🔥 ' + (u.streak||0) + '</div><div class="sc-label">Dias Seguidos</div></div>' +
      '<div class="stat-card"><div class="sc-value">📚 ' + doneL + '/' + totalL + '</div><div class="sc-label">Lições HSE</div></div>' +
      '<div class="stat-card"><div class="sc-value">❤️ ' + ((u.lives !== undefined && u.lives !== null) ? u.lives : 5) + '</div><div class="sc-label">Vidas</div></div></div>' +
    '<button class="btn-primary" style="margin-top:24px;background:linear-gradient(135deg,#666,#999)" onclick="logout()">Sair</button>';
}

function startLeaderLesson(lessonIdx) {
  if(!hasLives()) { showNoLivesModal(); return; }
  const mod = HSE_MODULE;
  const les = mod.lessons[lessonIdx];
  if(!les) return;
  state.currentModule = mod;
  state.currentLesson = les;
  _launchQuiz(les, state.currentUser);
}

function startLeaderRegularLesson(modIdx, lessonIdx) {
  if(!hasLives()) { showNoLivesModal(); return; }
  const mod = state.modules[modIdx];
  if(!mod) return;
  const les = mod.lessons[lessonIdx];
  if(!les) return;
  state.currentModule = mod;
  state.currentLesson = les;
  _launchQuiz(les, state.currentUser);
}

