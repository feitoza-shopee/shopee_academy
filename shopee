// Garante a ordem fixa dos módulos: mod_prova (1º), mod_hse (2º), mod_hse_lider (3º)
function ensureHSEFirst() {
  if(!Array.isArray(state.modules)) return;

  // Remove módulos legados de paleteiras (conteúdo agora está dentro do mod_hse)
  state.modules = state.modules.filter(m => m.id !== 'mod_paleteira' && m.id !== 'mod_paleteiras');

  // Garante que o módulo HSE Líderes exista para todos os usuários
  if(typeof HSE_LIDER_MODULE !== 'undefined' && !state.modules.some(m => m.id === HSE_LIDER_MODULE.id)) {
    state.modules.push(HSE_LIDER_MODULE);
  }

  // Fixa mod_hse_lider na posição 2 (3º módulo)
  const liderIdx = state.modules.findIndex(m => m.id === 'mod_hse_lider');
  if(liderIdx !== -1 && liderIdx !== 2) {
    const lider = state.modules.splice(liderIdx, 1)[0];
    state.modules.splice(2, 0, lider);
  }

  // Fixa mod_hse na posição 1 (2º módulo)
  const hseIdx = state.modules.findIndex(m => m.id === 'mod_hse');
  if(hseIdx !== -1 && hseIdx !== 1) {
    const hse = state.modules.splice(hseIdx, 1)[0];
    state.modules.splice(1, 0, hse);
  }

  // Fixa mod_prova na posição 0 (1º módulo — sempre primeiro)
  const provaIdx = state.modules.findIndex(m => m.id === 'mod_prova');
  if(provaIdx !== -1 && provaIdx !== 0) {
    const prova = state.modules.splice(provaIdx, 1)[0];
    state.modules.unshift(prova);
  }
}

