function leaderShowTab(tab) {
  const home    = document.getElementById('page-leader-home');
  const ranking = document.getElementById('page-leader-ranking');
  const btnHome    = document.getElementById('leader-tab-home');
  const btnRanking = document.getElementById('leader-tab-ranking');
  const shopeeColor = getComputedStyle(document.documentElement).getPropertyValue('--shopee').trim() || '#EE4D2D';
  const mutedColor  = getComputedStyle(document.documentElement).getPropertyValue('--text2').trim() || '#888';

  if(tab === 'home') {
    home.classList.remove('hidden');
    ranking.classList.add('hidden');
    btnHome.style.color    = shopeeColor;
    btnRanking.style.color = mutedColor;
  } else {
    home.classList.add('hidden');
    ranking.classList.remove('hidden');
    btnHome.style.color    = mutedColor;
    btnRanking.style.color = shopeeColor;
    state.leaderRankingTab = state.leaderRankingTab || 'turno';
    leaderSwitchRankingTab(state.leaderRankingTab);
  }
}

function leaderSwitchRankingTab(tab) {
  state.leaderRankingTab = tab;
  ['turno','unidade','nacional','cargo'].forEach(t => {
    const btn = document.getElementById('leader-rank-tab-'+t);
    if(btn) btn.classList.toggle('active', t === tab);
  });
  const listEl = document.getElementById('leader-ranking-list');
  const posEl  = document.getElementById('leader-ranking-by-position');
  if(tab === 'cargo') {
    if(listEl) listEl.style.display = 'none';
    if(posEl)  posEl.style.display  = 'block';
    leaderRenderRankingByPosition();
  } else {
    if(listEl) listEl.style.display = '';
    if(posEl)  posEl.style.display  = 'none';
    leaderRenderRanking(tab);
  }
}

async function leaderRenderRanking(tab) {
  const u = state.currentUser;
  const { data: usersData } = await getDB().from('users').select('*');
  (usersData || []).forEach(row => { state.users[row.id] = rowToUser(row); });
  const allUsers = Object.values(state.users).filter(usr => !usr.isAdmin);
  let filtered;
  if(tab==='turno')    filtered = allUsers.filter(usr => usr.unit===u.unit && usr.shift===u.shift);
  else if(tab==='unidade') filtered = allUsers.filter(usr => usr.unit===u.unit);
  else filtered = allUsers;
  filtered.sort((a,b) => (b.xp||0)-(a.xp||0));
  let html = '';
  filtered.forEach((usr, i) => {
    const pos = i+1;
    const isMe = usr.id === u.id;
    const posClass = pos===1?'gold':pos===2?'silver':pos===3?'bronze':'other';
    const posEmoji = pos===1?'🥇':pos===2?'🥈':pos===3?'🥉':pos;
    html += `<div class="ranking-item${isMe?' me':''}">
      <div class="rank-pos ${posClass}">${posEmoji}</div>
      <div class="rank-avatar">${usr.name.charAt(0)}</div>
      <div class="rank-info"><h4>${usr.name}${isMe?' (você)':''}</h4><p>${usr.unit} · ${usr.shift}${usr.position?' · '+usr.position:''} · 🔥${usr.streak||0} dias</p></div>
      <div class="rank-xp">⭐ ${(usr.xp||0).toLocaleString()}</div>
    </div>`;
  });
  if(!filtered.length) html='<p style="text-align:center;color:var(--text2);font-weight:700;padding:40px 0">Nenhum usuário neste filtro ainda.</p>';
  const listEl = document.getElementById('leader-ranking-list');
  if(listEl) listEl.innerHTML = html;
}

async function leaderRenderRankingByPosition() {
  const { data: usersData } = await getDB().from('users').select('*');
  (usersData || []).forEach(row => { state.users[row.id] = rowToUser(row); });
  const allUsers = Object.values(state.users).filter(usr => !usr.isAdmin);
  const positions = [...new Set(allUsers.map(u => u.position||'Sem Cargo').filter(Boolean))];
  let html = '';
  positions.forEach(pos => {
    const group = allUsers.filter(u => (u.position||'Sem Cargo') === pos).sort((a,b)=>(b.xp||0)-(a.xp||0));
    html += `<div style="margin-bottom:20px;">
      <div style="font-weight:900;font-size:13px;color:var(--shopee);margin-bottom:8px;padding:6px 10px;background:var(--shopee-bg,#FFF0EE);border-radius:10px;">👤 ${pos}</div>`;
    group.forEach((usr, i) => {
      const isMe = usr.id === state.currentUser.id;
      const posEmoji = i===0?'🥇':i===1?'🥈':i===2?'🥉':(i+1);
      html += `<div class="ranking-item${isMe?' me':''}">
        <div class="rank-pos ${i<3?['gold','silver','bronze'][i]:'other'}">${posEmoji}</div>
        <div class="rank-avatar">${usr.name.charAt(0)}</div>
        <div class="rank-info"><h4>${usr.name}${isMe?' (você)':''}</h4><p>${usr.unit} · ${usr.shift} · 🔥${usr.streak||0} dias</p></div>
        <div class="rank-xp">⭐ ${(usr.xp||0).toLocaleString()}</div>
      </div>`;
    });
    html += '</div>';
  });
  if(!html) html='<p style="text-align:center;color:var(--text2);font-weight:700;padding:40px 0">Nenhum usuário cadastrado ainda.</p>';
  const posEl = document.getElementById('leader-ranking-by-position');
  if(posEl) posEl.innerHTML = html;
}
