function adminSaveQuestion(modId, lessonId) {
  const mod    = state.modules.find(m=>m.id===modId);
  const lesson = mod&&mod.lessons.find(l=>l.id===lessonId);
  if(!mod||!lesson) return;

  const type = document.getElementById('q-type').value;
  const qText = document.getElementById('q-text').value.trim();
  const explanation = document.getElementById('q-explanation').value.trim();
  const msgEl = document.getElementById('q-form-msg');

  if(!qText) { msgEl.innerHTML='<div class="error-msg">Digite a pergunta.</div>'; return; }
  if(!explanation) { msgEl.innerHTML='<div class="error-msg">Adicione uma explicação.</div>'; return; }

  let question = { type, q:qText, explanation };

  if(type==='multiple') {
    const opts = [0,1,2,3].map(i=>(document.getElementById('opt-'+i)||{}).value||'').map(s=>s.trim());
    if(opts.some(o=>!o)) { msgEl.innerHTML='<div class="error-msg">Preencha todas as 4 opções.</div>'; return; }
    const correctRadio = document.querySelector('input[name="correct-opt"]:checked');
    const answer = correctRadio ? parseInt(correctRadio.value) : 0;
    question.options = opts;
    question.answer  = answer;

  } else if(type==='truefalse') {
    const tfRadio = document.querySelector('input[name="tf-answer"]:checked');
    question.answer = tfRadio ? tfRadio.value === 'true' : true;

  } else if(type==='order') {
    const steps = [0,1,2,3].map(i=>(document.getElementById('step-'+i)||{}).value||'').map(s=>s.trim()).filter(Boolean);
    if(steps.length < 2) { msgEl.innerHTML='<div class="error-msg">Adicione pelo menos 2 etapas.</div>'; return; }
    question.steps = steps;
    question.correctOrder = steps.map((_,i)=>i);
  }

  lesson.questions.push(question);
  saveModules();

  // refresh list
  const listEl = document.getElementById('q-list-'+lessonId);
  if(listEl) listEl.innerHTML = renderQuestionList(mod, lesson);

  // also update lesson question count badge in admin list
  const modListEl = document.getElementById('adm-modules-list');
  if(modListEl) modListEl.innerHTML = renderAdminModulesList();

  // clear form
  document.getElementById('q-text').value='';
  document.getElementById('q-explanation').value='';
  adminUpdateQForm();
  msgEl.innerHTML='<div style="background:#EAFAF1;border:1px solid var(--green);color:#1E8449;padding:7px 10px;border-radius:8px;font-weight:700;font-size:12px;">✅ Pergunta salva!</div>';
  setTimeout(()=>{ if(msgEl) msgEl.innerHTML=''; },2000);

  // update overlay header count
  const overlay = document.getElementById('q-editor-overlay');
  if(overlay) {
    const headerCount = overlay.querySelector('div[style*="opacity:0.8"]');
    if(headerCount) headerCount.textContent = `${lesson.questions.length} pergunta(s) · ${lesson.xpReward} XP`;
  }
  renderHome();
}

function adminDeleteQuestion(modId, lessonId, qi) {
  const mod    = state.modules.find(m=>m.id===modId);
  const lesson = mod&&mod.lessons.find(l=>l.id===lessonId);
