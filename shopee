}
.profile-hero h2 { font-size:20px; font-weight:900; margin-bottom:4px; }
.profile-hero p { font-size:13px; opacity:0.85; font-weight:600; }

.stats-grid {
  display:grid; grid-template-columns:repeat(2,1fr); gap:12px;
  margin-bottom:20px;
}
.stat-card {
  background:#fff;
  border-radius:14px;
  padding:18px 16px;
  border:2px solid var(--border);
  text-align:center;
}
.stat-card .sc-value { font-size:28px; font-weight:900; color:var(--shopee); }
.stat-card .sc-label { font-size:12px; color:var(--text2); font-weight:700; text-transform:uppercase; letter-spacing:0.5px; margin-top:4px; }

.achievements-grid {
  display:grid; grid-template-columns:repeat(3,1fr); gap:10px;
}
.achievement {
  background:#fff;
  border-radius:12px;
  padding:14px 8px;
  text-align:center;
  border:2px solid var(--border);
}
.achievement .ach-icon { font-size:28px; margin-bottom:6px; }
.achievement .ach-name { font-size:11px; font-weight:800; color:var(--text2); }
.achievement.unlocked { border-color:var(--gold); background:#FFFDF0; }

/* ===== ADMIN SCREEN ===== */
.admin-card {
  background:#fff;
  border-radius:16px;
  padding:20px;
  border:2px solid var(--border);
