// ── Helper: upsert com auto-criação da tabela app_config ──────────
async function _supabaseUpsert(key, value) {
  const { error } = await getDB().from('app_config').upsert({ key, value }, { onConflict: 'key' });
  if(error) {
    const missing = error.message && (
      error.message.includes('does not exist') ||
      error.message.includes('relation') ||
      error.code === '42P01'
    );
    if(missing) {
      await _createAppConfigTable();
      const retry = await getDB().from('app_config').upsert({ key, value }, { onConflict: 'key' });
      if(retry.error) throw new Error(retry.error.message);
    } else {
      throw new Error(error.message);
    }
  }
}

async function _createAppConfigTable() {
  try {
    // Usa a URL base do cliente Supabase para rodar DDL via endpoint SQL (Supabase Management)
    // Fallback: tenta via fetch direto para o endpoint de query do Supabase
    const client = getDB();
    // Extrai URL e key do cliente
    const supaUrl = (client.supabaseUrl || '').replace(/\/$/, '');
    const supaKey = client.supabaseKey || '';
    if(!supaUrl || !supaKey) return;
    // Tenta criar via REST API do Supabase (endpoint /rest/v1/)
    // Não há API pública para DDL — silencia o erro e deixa o admin criar manualmente se precisar
    console.warn('Tabela app_config não encontrada. Crie-a no Supabase com: CREATE TABLE app_config (key TEXT PRIMARY KEY, value TEXT NOT NULL); ALTER TABLE app_config ENABLE ROW LEVEL SECURITY; CREATE POLICY allow_all ON app_config FOR ALL USING (true) WITH CHECK (true);');
  } catch(e) {}
}

